 "ayahs": [
  {
   "number": 1,
   "globalNumber": 5949,
   "juz": 30,
   "page": 591,
   "text": "سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى",
   "translation": "Sucikanlah nama Tuhanmu Yang Maha Tingi,",
   "tajweed": "سَبِّحِ [h:14437[ٱ]سْمَ رَبِّكَ [h:14438[ٱ]لْأَعْلَى",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/087001.mp3"
  },
  {
   "number": 2,
   "globalNumber": 5950,
   "juz": 30,
   "page": 591,
   "text": "ٱلَّذِى خَلَقَ فَسَوَّىٰ",
   "translation": "yang menciptakan, dan menyempurnakan (penciptaan-Nya),",
   "tajweed": "ٱلَّذِى خَلَقَ فَسَوَّىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/087002.mp3"
  },
  {
   "number": 3,
   "globalNumber": 5951,
   "juz": 30,
   "page": 591,
   "text": "وَٱلَّذِى قَدَّرَ فَهَدَىٰ",
   "translation": "dan yang menentukan kadar (masing-masing) dan memberi petunjuk,",
   "tajweed": "وَ[h:9999[ٱ]لَّذِى قَدَّرَ فَهَدَىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/087003.mp3"
  },
  {
   "number": 4,
   "globalNumber": 5952,
   "juz": 30,
   "page": 591,
   "text": "وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ",
   "translation": "dan yang menumbuhkan rumput-rumputan,",
   "tajweed": "وَ[h:9999[ٱ]لَّذ[o[ِىٓ] أَخْرَجَ [h:14439[ٱ]لْمَرْعَىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/087004.mp3"
  },
  {
   "number": 5,
   "globalNumber": 5953,
   "juz": 30,
   "page": 591,
   "text": "فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ",
   "translation": "lalu dijadikan-Nya rumput-rumput itu kering kehitam-hitaman.",
   "tajweed": "فَجَعَلَهُ[n[ۥ] غُث[o[َا]ٓءً أَحْوَىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/087005.mp3"
  },
  {
   "number": 6,
   "globalNumber": 5954,
   "juz": 30,
   "page": 591,
   "text": "سَنُقْرِئُكَ فَلَا تَنسَىٰٓ",
   "translation": "Kami akan membacakan (Al Quran) kepadamu (Muhammad) maka kamu tidak akan lupa,",
   "tajweed": "سَنُ[q:14440[قْ]رِئُكَ فَلَا تَ[f:14441[نس]َىٰٓ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/087006.mp3"
  },
  {
   "number": 7,
   "globalNumber": 5955,
   "juz": 30,
   "page": 591,
   "text": "إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ",
   "translation": "kecuali kalau Allah menghendaki. Sesungguhnya Dia mengetahui yang terang dan yang tersembunyi.",
   "tajweed": "إِلَّا مَا ش[o[َا]ٓءَ [h:78[ٱ]للَّهُ‌ۚ إِ[g[نّ]َهُ[n[ۥ] يَعْلَمُ [h:8891[ٱ]لْجَهْرَ وَمَا يَخْفَىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/087007.mp3"
  },
  {
   "number": 8,
   "globalNumber": 5956,
   "juz": 30,
   "page": 591,
   "text": "وَنُيَسِّرُكَ لِلْيُسْرَىٰ",
   "translation": "dan Kami akan memberi kamu taufik ke jalan yang mudah,",
   "tajweed": "وَنُيَسِّرُكَ لِلْيُسْرَىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/087008.mp3"
  },
  {
   "number": 9,
   "globalNumber": 5957,
   "juz": 30,
   "page": 591,
   "text": "فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ",
   "translation": "oleh sebab itu berikanlah peringatan karena peringatan itu bermanfaat,",
   "tajweed": "فَذَكِّرْ إ[a:14442[ِن ن]َّفَعَتِ [h:14443[ٱ][l[ل]ذِّكْرَىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/087009.mp3"
  },
  {
   "number": 10,
   "globalNumber": 5958,
   "juz": 30,
   "page": 591,
   "text": "سَيَذَّكَّرُ مَن يَخْشَىٰ",
   "translation": "orang yang takut (kepada Allah) akan mendapat pelajaran,",
   "tajweed": "سَيَذَّكَّرُ م[a:14444[َن ي]َخْشَىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/087010.mp3"
  },
  {
   "number": 11,
   "globalNumber": 5959,
   "juz": 30,
   "page": 591,
   "text": "وَيَتَجَنَّبُهَا ٱلْأَشْقَى",
   "translation": "dan orang-orang yang celaka (kafir) akan menjauhinya.",
   "tajweed": "وَيَتَجَ[g[نّ]َبُهَا [h:14445[ٱ]لْأَشْقَى",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/087011.mp3"
  },
  {
   "number": 12,
   "globalNumber": 5960,
   "juz": 30,
   "page": 591,
   "text": "ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ",
   "translation": "(Yaitu) orang yang akan memasuki api yang besar (neraka).",
   "tajweed": "ٱلَّذِى يَصْلَى [h:14446[ٱ][l[ل][g[نّ]َارَ [h:14447[ٱ]لْكُ[q:8463[بْ]رَىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/087012.mp3"
  },
  {
   "number": 13,
   "globalNumber": 5961,
   "juz": 30,
   "page": 591,
   "text": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ",
   "translation": "Kemudian dia tidak akan mati di dalamnya dan tidak (pula) hidup.",
   "tajweed": "ثُ[g[مّ]َ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/087013.mp3"
  },
  {
   "number": 14,
   "globalNumber": 5962,
   "juz": 30,
   "page": 591,
   "text": "قَدْ أَفْلَحَ مَن تَزَكَّىٰ",
   "translation": "Sesungguhnya beruntunglah orang yang membersihkan diri (dengan beriman),",
   "tajweed": "قَ[q:298[دْ] أَفْلَحَ مَ[f:8555[ن ت]َزَكَّىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/087014.mp3"
  },
  {
   "number": 15,
   "globalNumber": 5963,
   "juz": 30,
   "page": 591,
   "text": "وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ",
   "translation": "dan dia ingat nama Tuhannya, lalu dia sembahyang.",
   "tajweed": "وَذَكَرَ [h:14448[ٱ]سْمَ رَبِّه[n[ِۦ] فَصَلَّىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/087015.mp3"
  },
  {
   "number": 16,
   "globalNumber": 5964,
   "juz": 30,
   "page": 592,
   "text": "بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا",
   "translation": "Tetapi kamu (orang-orang kafir) memilih kehidupan duniawi.",
   "tajweed": "بَلْ تُؤْثِرُونَ [h:14449[ٱ]لْحَيَ[s[و][n[ٲ]ةَ [h:446[ٱ][l[ل]دُّنْيَا",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/087016.mp3"
  },
  {
   "number": 17,
   "globalNumber": 5965,
   "juz": 30,
   "page": 592,
   "text": "وَٱلْءَاخِرَةُ خَيْرٌۭ وَأَبْقَىٰٓ",
   "translation": "Sedang kehidupan akhirat adalah lebih baik dan lebih kekal.",
   "tajweed": "وَ[h:9999[ٱ]لْأَخِرَةُ خَيْ[a:8546[رٌ و]َأَ[q:8540[بْ]قَىٰٓ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/087017.mp3"
  },
  {
   "number": 18,
   "globalNumber": 5966,
   "juz": 30,
   "page": 592,
   "text": "إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ",
   "translation": "Sesungguhnya ini benar-benar terdapat dalam kitab-kitab yang dahulu,",
   "tajweed": "إِ[g[نّ]َ هَ[n[ـٰ]ذَا لَفِى [h:14450[ٱ][l[ل]صُّحُفِ [h:8657[ٱ]لْأُولَىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/087018.mp3"
  },
  {
   "number": 19,
   "globalNumber": 5967,
   "juz": 30,
   "page": 592,
   "text": "صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ",
   "translation": "(yaitu) Kitab-kitab Ibrahim dan Musa",
   "tajweed": "صُحُفِ إِ[q:1860[بْ]ر[n[َٲ]هِيمَ وَمُوسَىٰ",
