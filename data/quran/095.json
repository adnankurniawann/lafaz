  },
  {
   "number": 4,
   "globalNumber": 6102,
   "juz": 30,
   "page": 597,
   "text": "لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍۢ",
   "translation": "sesungguhnya Kami telah menciptakan manusia dalam bentuk yang sebaik-baiknya.",
   "tajweed": "لَقَ[q:2389[دْ] خَلَ[q:5159[قْ]نَا [h:7228[ٱ]لْإِ[f:5969[نس]َ[n[ـٰ]نَ ف[o[ِىٓ] أَحْسَنِ تَ[q:14556[قْ]و[p[ِي]مٍ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/095004.mp3"
  },
  {
   "number": 5,
   "globalNumber": 6103,
   "juz": 30,
   "page": 597,
   "text": "ثُمَّ رَدَدْنَٰهُ أَسْفَلَ سَٰفِلِينَ",
   "translation": "Kemudian Kami kembalikan dia ke tempat yang serendah-rendahnya (neraka),",
   "tajweed": "ثُ[g[مّ]َ رَدَ[q:14557[دْ]نَ[n[ـٰ]هُ أَسْفَلَ سَ[n[ـٰ]فِل[p[ِي]نَ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/095005.mp3"
  },
  {
   "number": 6,
   "globalNumber": 6104,
   "juz": 30,
   "page": 597,
   "text": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۢ",
   "translation": "kecuali orang-orang yang beriman dan mengerjakan amal saleh; maka bagi mereka pahala yang tiada putus-putusnya.",
   "tajweed": "إِلَّا [h:778[ٱ]لَّذِينَ ءَامَنُو[s[اْ] وَعَمِلُو[s[اْ] [h:118[ٱ][l[ل]صَّ[n[ـٰ]لِحَ[n[ـٰ]تِ فَلَهُمْ أَ[q:2423[جْ]رٌ غَيْرُ مَمْن[p[ُو]نٍ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/095006.mp3"
  },
  {
   "number": 7,
   "globalNumber": 6105,
   "juz": 30,
   "page": 597,
   "text": "فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ",
