{
 "number": 92,
 "name": "سُورَةُ اللَّيۡلِ",
 "englishName": "Al-Lail",
 "englishNameTranslation": "The Night",
 "revelationType": "Meccan",
 "ayahCount": 21,
 "hasBasmalah": true,
 "ayahs": [
  {
   "number": 1,
   "globalNumber": 6059,
   "juz": 30,
   "page": 595,
   "text": "وَٱلَّيْلِ إِذَا يَغْشَىٰ",
   "translation": "Demi malam apabila menutupi (cahaya siang),",
   "tajweed": "وَ[h:9999[ٱ]لَّيْلِ إِذَا يَغْشَىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/092001.mp3"
  },
  {
   "number": 2,
   "globalNumber": 6060,
   "juz": 30,
   "page": 595,
   "text": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ",
   "translation": "dan siang apabila terang benderang,",
   "tajweed": "وَ[h:9999[ٱ][l[ل][g[نّ]َهَارِ إِذَا تَجَلَّىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/092002.mp3"
  },
  {
   "number": 3,
   "globalNumber": 6061,
   "juz": 30,
   "page": 595,
   "text": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ",
   "translation": "dan penciptaan laki-laki dan perempuan,",
   "tajweed": "وَمَا خَلَقَ [h:14531[ٱ][l[ل]ذَّكَرَ وَ[h:929[ٱ]لْأُ[f:929[نث]َىٰٓ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/092003.mp3"
  },
  {
   "number": 4,
   "globalNumber": 6062,
   "juz": 30,
   "page": 595,
   "text": "إِنَّ سَعْيَكُمْ لَشَتَّىٰ",
   "translation": "sesungguhnya usaha kamu memang berbeda-beda.",
   "tajweed": "إِ[g[نّ]َ سَعْيَكُمْ لَشَتَّىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/092004.mp3"
  },
  {
   "number": 5,
   "globalNumber": 6063,
   "juz": 30,
   "page": 595,
   "text": "فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ",
   "translation": "Adapun orang yang memberikan (hartanya di jalan Allah) dan bertakwa,",
   "tajweed": "فَأَ[g[مّ]َا مَنْ أَعْطَىٰ وَ[h:2036[ٱ]تَّقَىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/092005.mp3"
  },
  {
   "number": 6,
   "globalNumber": 6064,
   "juz": 30,
   "page": 595,
   "text": "وَصَدَّقَ بِٱلْحُسْنَىٰ",
   "translation": "dan membenarkan adanya pahala yang terbaik (surga),",
   "tajweed": "وَصَدَّقَ بِ[h:13002[ٱ]لْحُسْنَىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/092006.mp3"
  },
  {
   "number": 7,
   "globalNumber": 6065,
   "juz": 30,
   "page": 595,
   "text": "فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ",
   "translation": "maka Kami kelak akan menyiapkan baginya jalan yang mudah.",
   "tajweed": "فَسَنُيَسِّرُهُ[n[ۥ] لِلْيُسْرَىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/092007.mp3"
  },
  {
   "number": 8,
   "globalNumber": 6066,
   "juz": 30,
   "page": 595,
   "text": "وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ",
   "translation": "Dan adapun orang-orang yang bakhil dan merasa dirinya cukup,",
   "tajweed": "وَأَ[g[مّ]َا م[i:14532[َنۢ ب]َخِلَ وَ[h:13634[ٱ]سْتَغْنَىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/092008.mp3"
  },
  {
   "number": 9,
   "globalNumber": 6067,
   "juz": 30,
   "page": 595,
   "text": "وَكَذَّبَ بِٱلْحُسْنَىٰ",
   "translation": "serta mendustakan pahala terbaik,",
   "tajweed": "وَكَذَّبَ بِ[h:13002[ٱ]لْحُسْنَىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/092009.mp3"
  },
  {
   "number": 10,
   "globalNumber": 6068,
   "juz": 30,
   "page": 595,
   "text": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ",
   "translation": "maka kelak Kami akan menyiapkan baginya (jalan) yang sukar.",
   "tajweed": "فَسَنُيَسِّرُهُ[n[ۥ] لِلْعُسْرَىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/092010.mp3"
  },
  {
   "number": 11,
   "globalNumber": 6069,
   "juz": 30,
   "page": 595,
   "text": "وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ",
   "translation": "Dan hartanya tidak bermanfaat baginya apabila ia telah binasa.",
   "tajweed": "وَمَا يُغْنِى عَنْهُ مَالُهُ[o[ۥٓ] إِذَا تَرَدَّىٰٓ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/092011.mp3"
  },
  {
   "number": 12,
   "globalNumber": 6070,
   "juz": 30,
   "page": 595,
   "text": "إِنَّ عَلَيْنَا لَلْهُدَىٰ",
   "translation": "Sesungguhnya kewajiban Kamilah memberi petunjuk,",
   "tajweed": "إِ[g[نّ]َ عَلَيْنَا لَلْهُدَىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/092012.mp3"
  },
  {
   "number": 13,
   "globalNumber": 6071,
   "juz": 30,
   "page": 595,
   "text": "وَإِنَّ لَنَا لَلْءَاخِرَةَ وَٱلْأُولَىٰ",
   "translation": "dan sesungguhnya kepunyaan Kamilah akhirat dan dunia.",
   "tajweed": "وَإِ[g[نّ]َ لَنَا لَلْأَخِرَةَ وَ[h:12987[ٱ]لْأُولَىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/092013.mp3"
  },
  {
   "number": 14,
   "globalNumber": 6072,
   "juz": 30,
   "page": 595,
   "text": "فَأَنذَرْتُكُمْ نَارًۭا تَلَظَّىٰ",
   "translation": "Maka, kami memperingatkan kamu dengan neraka yang menyala-nyala.",
   "tajweed": "فَأَ[f:14533[نذ]َرْتُكُمْ نَا[f:14534[رًا ت]َلَظَّىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/092014.mp3"
  },
  {
   "number": 15,
   "globalNumber": 6073,
   "juz": 30,
   "page": 596,
   "text": "لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى",
   "translation": "Tidak ada yang masuk ke dalamnya kecuali orang yang paling celaka,",
   "tajweed": "لَا يَصْلَ[n[ـٰ]ه[o[َآ] إِلَّا [h:14535[ٱ]لْأَشْقَى",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/092015.mp3"
  },
  {
   "number": 16,
   "globalNumber": 6074,
   "juz": 30,
   "page": 596,
   "text": "ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ",
   "translation": "yang mendustakan (kebenaran) dan berpaling (dari iman).",
   "tajweed": "ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/092016.mp3"
  },
  {
   "number": 17,
   "globalNumber": 6075,
   "juz": 30,
   "page": 596,
   "text": "وَسَيُجَنَّبُهَا ٱلْأَتْقَى",
   "translation": "Dan kelak akan dijauhkan orang yang paling takwa dari neraka itu,",
   "tajweed": "وَسَيُجَ[g[نّ]َبُهَا [h:14536[ٱ]لْأَتْقَى",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/092017.mp3"
  },
  {
   "number": 18,
   "globalNumber": 6076,
   "juz": 30,
   "page": 596,
   "text": "ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ",
   "translation": "yang menafkahkan hartanya (di jalan Allah) untuk membersihkannya,",
   "tajweed": "ٱلَّذِى يُؤْتِى مَالَهُ[n[ۥ] يَتَزَكَّىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/092018.mp3"
  },
  {
   "number": 19,
   "globalNumber": 6077,
   "juz": 30,
   "page": 596,
   "text": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍۢ تُجْزَىٰٓ",
   "translation": "padahal tidak ada seseorangpun memberikan suatu nikmat kepadanya yang harus dibalasnya,",
   "tajweed": "وَمَا لِأَحَدٍ عِ[f:719[ند]َهُ[n[ۥ] م[a:7433[ِن ن]ِّعْمَ[f:14537[ةٍ ت]ُ[q:11814[جْ]زَىٰٓ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/092019.mp3"
  },
  {
   "number": 20,
   "globalNumber": 6078,
   "juz": 30,
   "page": 596,
   "text": "إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ",
   "translation": "tetapi (dia memberikan itu semata-mata) karena mencari keridhaan Tuhannya yang Maha Tinggi.",
   "tajweed": "إِلَّا [h:1610[ٱ][q:1130[بْ]تِغ[o[َا]ٓءَ وَ[q:1611[جْ]هِ رَبِّهِ [h:14538[ٱ]لْأَعْلَىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/092020.mp3"
  },
  {
   "number": 21,
   "globalNumber": 6079,
   "juz": 30,
   "page": 596,
   "text": "وَلَسَوْفَ يَرْضَىٰ",
   "translation": "Dan kelak dia benar-benar mendapat kepuasan.",
   "tajweed": "وَلَسَوْفَ يَرْضَىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/092021.mp3"
  }
 ]
}
