{
 "number": 89,
 "name": "سُورَةُ الفَجۡرِ",
 "englishName": "Al-Fajr",
 "englishNameTranslation": "The Dawn",
 "revelationType": "Meccan",
 "ayahCount": 30,
 "hasBasmalah": true,
 "ayahs": [
  {
   "number": 1,
   "globalNumber": 5994,
   "juz": 30,
   "page": 593,
   "text": "وَٱلْفَجْرِ",
   "translation": "Demi fajar,",
   "tajweed": "وَ[h:9999[ٱ]لْفَ[q:14468[جْ]رِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/089001.mp3"
  },
  {
   "number": 2,
   "globalNumber": 5995,
   "juz": 30,
   "page": 593,
   "text": "وَلَيَالٍ عَشْرٍۢ",
   "translation": "dan malam yang sepuluh,",
   "tajweed": "وَلَيَالٍ عَشْرٍ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/089002.mp3"
  },
  {
   "number": 3,
   "globalNumber": 5996,
   "juz": 30,
   "page": 593,
   "text": "وَٱلشَّفْعِ وَٱلْوَتْرِ",
   "translation": "dan yang genap dan yang ganjil,",
   "tajweed": "وَ[h:9999[ٱ][l[ل]شَّفْعِ وَ[h:14469[ٱ]لْوَتْرِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/089003.mp3"
  },
  {
   "number": 4,
   "globalNumber": 5997,
   "juz": 30,
   "page": 593,
   "text": "وَٱلَّيْلِ إِذَا يَسْرِ",
   "translation": "dan malam bila berlalu.",
   "tajweed": "وَ[h:9999[ٱ]لَّيْلِ إِذَا يَسْرِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/089004.mp3"
  },
  {
   "number": 5,
   "globalNumber": 5998,
   "juz": 30,
   "page": 593,
   "text": "هَلْ فِى ذَٰلِكَ قَسَمٌۭ لِّذِى حِجْرٍ",
   "translation": "Pada yang demikian itu terdapat sumpah (yang dapat diterima) oleh orang-orang yang berakal.",
   "tajweed": "هَلْ فِى ذ[n[َٲ]لِكَ قَسَ[u:14470[مٌ ل]ِّذِى حِ[q:14471[جْ]رٍ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/089005.mp3"
  },
  {
   "number": 6,
   "globalNumber": 5999,
   "juz": 30,
   "page": 593,
   "text": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ",
   "translation": "Apakah kamu tidak memperhatikan bagaimana Tuhanmu berbuat terhadap kaum 'Aad?",
   "tajweed": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِع[p[َا][q[د]ٍ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/089006.mp3"
  },
  {
   "number": 7,
   "globalNumber": 6000,
   "juz": 30,
   "page": 593,
   "text": "إِرَمَ ذَاتِ ٱلْعِمَادِ",
   "translation": "(yaitu) penduduk Iram yang mempunyai bangunan-bangunan yang tinggi,",
   "tajweed": "إِرَمَ ذَاتِ [h:14472[ٱ]لْعِم[p[َا][q[د]ِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/089007.mp3"
  },
  {
   "number": 8,
   "globalNumber": 6001,
   "juz": 30,
   "page": 593,
   "text": "ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَٰدِ",
   "translation": "yang belum pernah dibangun (suatu kota) seperti itu, di negeri-negeri lain,",
   "tajweed": "ٱلَّتِى لَمْ يُخْلَ[q:14473[قْ] مِثْلُهَا فِى [h:2519[ٱ]لْبِلَ[p[ـٰ][q[د]ِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/089008.mp3"
  },
  {
   "number": 9,
   "globalNumber": 6002,
   "juz": 30,
   "page": 593,
   "text": "وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ",
   "translation": "dan kaum Tsamud yang memotong batu-batu besar di lembah,",
   "tajweed": "وَثَمُودَ [h:14474[ٱ]لَّذِينَ جَابُو[s[اْ] [h:14475[ٱ][l[ل]صَّخْرَ بِ[h:8451[ٱ]لْو[p[َا][q[د]ِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/089009.mp3"
  },
  {
   "number": 10,
   "globalNumber": 6003,
   "juz": 30,
   "page": 593,
   "text": "وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ",
   "translation": "dan kaum Fir'aun yang mempunyai pasak-pasak (tentara yang banyak),",
   "tajweed": "وَفِرْعَوْنَ ذِى [h:14476[ٱ]لْأَوْت[p[َا][q[د]ِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/089010.mp3"
  },
  {
   "number": 11,
   "globalNumber": 6004,
   "juz": 30,
   "page": 593,
   "text": "ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَٰدِ",
   "translation": "yang berbuat sewenang-wenang dalam negeri,",
   "tajweed": "ٱلَّذِينَ طَغَوْ[s[اْ] فِى [h:2519[ٱ]لْبِلَ[p[ـٰ][q[د]ِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/089011.mp3"
  },
  {
   "number": 12,
   "globalNumber": 6005,
   "juz": 30,
   "page": 593,
   "text": "فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ",
   "translation": "lalu mereka berbuat banyak kerusakan dalam negeri itu,",
   "tajweed": "فَأَكْثَرُو[s[اْ] فِيهَا [h:14477[ٱ]لْفَس[p[َا][q[د]َ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/089012.mp3"
  },
  {
   "number": 13,
   "globalNumber": 6006,
   "juz": 30,
   "page": 593,
   "text": "فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ",
   "translation": "karena itu Tuhanmu menimpakan kepada mereka cemeti azab,",
   "tajweed": "فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذ[p[َا][q[ب]ٍ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/089013.mp3"
  },
  {
   "number": 14,
   "globalNumber": 6007,
   "juz": 30,
   "page": 593,
   "text": "إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ",
   "translation": "sesungguhnya Tuhanmu benar-benar mengawasi.",
   "tajweed": "إِ[g[نّ]َ رَبَّكَ لَبِ[h:14478[ٱ]لْمِرْص[p[َا][q[د]ِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/089014.mp3"
  },
  {
   "number": 15,
   "globalNumber": 6008,
   "juz": 30,
   "page": 593,
   "text": "فَأَمَّا ٱلْإِنسَٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ",
   "translation": "Adapun manusia apabila Tuhannya mengujinya lalu dia dimuliakan-Nya dan diberi-Nya kesenangan, maka dia akan berkata: \"Tuhanku telah memuliakanku\".",
   "tajweed": "فَأَ[g[مّ]َا [h:14479[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ إِذَا مَا [h:14480[ٱ][q:14481[بْ]تَلَ[n[ـٰ]هُ رَبُّهُ[n[ۥ] فَأَكْرَمَهُ[n[ۥ] وَنَعَّمَهُ[n[ۥ] فَيَقُولُ رَبّ[o[ِىٓ] أَكْرَمَنِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/089015.mp3"
  },
  {
   "number": 16,
   "globalNumber": 6009,
   "juz": 30,
   "page": 593,
   "text": "وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَٰنَنِ",
   "translation": "Adapun bila Tuhannya mengujinya lalu membatasi rezekinya maka dia berkata: \"Tuhanku menghinakanku\".",
   "tajweed": "وَأَ[g[مّ][o[َآ] إِذَا مَا [h:14480[ٱ][q:14481[بْ]تَلَ[n[ـٰ]هُ فَقَدَرَ عَلَيْهِ رِزْقَهُ[n[ۥ] فَيَقُولُ رَبّ[o[ِىٓ] أَهَ[n[ـٰ]نَنِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/089016.mp3"
  },
  {
   "number": 17,
   "globalNumber": 6010,
   "juz": 30,
   "page": 593,
   "text": "كَلَّا ۖ بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ",
   "translation": "Sekali-kali tidak (demikian), sebenarnya kamu tidak memuliakan anak yatim,",
   "tajweed": "كَلَّا‌ۖ بَل لَّا تُكْرِمُونَ [h:14482[ٱ]لْيَت[p[ِي]مَ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/089017.mp3"
  },
  {
   "number": 18,
   "globalNumber": 6011,
   "juz": 30,
   "page": 593,
   "text": "وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ",
   "translation": "dan kamu tidak saling mengajak memberi makan orang miskin,",
   "tajweed": "وَلَا تَحَ[m[ـٰٓ]ضُّونَ عَلَىٰ طَعَامِ [h:13901[ٱ]لْمِسْك[p[ِي]نِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/089018.mp3"
  },
  {
   "number": 19,
   "globalNumber": 6012,
   "juz": 30,
   "page": 593,
   "text": "وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًۭا لَّمًّۭا",
   "translation": "dan kamu memakan harta pusaka dengan cara mencampur baurkan (yang halal dan yang bathil),",
   "tajweed": "وَتَأْكُلُونَ [h:14483[ٱ][l[ل]تُّرَاثَ أَكْل[u:14484[اً ل]َّ[g[مّ]ًا",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/089019.mp3"
  },
  {
   "number": 20,
   "globalNumber": 6013,
   "juz": 30,
   "page": 593,
   "text": "وَتُحِبُّونَ ٱلْمَالَ حُبًّۭا جَمًّۭا",
   "translation": "dan kamu mencintai harta benda dengan kecintaan yang berlebihan.",
   "tajweed": "وَتُحِبُّونَ [h:14485[ٱ]لْمَالَ حُب[f:14486[ًّا ج]َ[g[مّ]ًا",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/089020.mp3"
  },
  {
   "number": 21,
   "globalNumber": 6014,
   "juz": 30,
   "page": 593,
   "text": "كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّۭا دَكًّۭا",
   "translation": "Jangan (berbuat demikian). Apabila bumi digoncangkan berturut-turut,",
   "tajweed": "كَلّ[o[َآ] إِذَا دُكَّتِ [h:14487[ٱ]لْأَرْضُ دَك[f:14488[ًّا د]َكًّا",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/089021.mp3"
  },
  {
   "number": 22,
   "globalNumber": 6015,
   "juz": 30,
   "page": 593,
   "text": "وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّۭا صَفًّۭا",
   "translation": "dan datanglah Tuhanmu; sedang malaikat berbaris-baris.",
   "tajweed": "وَج[o[َا]ٓءَ رَبُّكَ وَ[h:14489[ٱ]لْمَلَكُ صَف[f:14490[ًّا ص]َفًّا",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/089022.mp3"
  },
  {
   "number": 23,
   "globalNumber": 6016,
   "juz": 30,
   "page": 593,
   "text": "وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ ۚ يَوْمَئِذٍۢ يَتَذَكَّرُ ٱلْإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ",
   "translation": "Dan pada hari itu diperlihatkan neraka Jahannam; dan pada hari itu ingatlah manusia, akan tetapi tidak berguna lagi mengingat itu baginya.",
   "tajweed": "وَجِ[s[اْ][o[ىٓ]ءَ يَوْمَئِ[i:14491[ذِۭ ب]ِجَهَ[g[نّ]َمَ‌ۚ يَوْمَئِ[a:14492[ذٍ ي]َتَذَكَّرُ [h:14286[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ وَأَ[g[نّ]َىٰ لَهُ [h:14493[ٱ][l[ل]ذِّكْرَىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/089023.mp3"
  },
  {
   "number": 24,
   "globalNumber": 6017,
   "juz": 30,
   "page": 594,
   "text": "يَقُولُ يَٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى",
   "translation": "Dia mengatakan: \"Alangkah baiknya kiranya aku dahulu mengerjakan (amal saleh) untuk hidupku ini\".",
   "tajweed": "يَقُولُ يَ[n[ـٰ]لَيْتَنِى قَدَّمْتُ لِحَيَاتِى",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/089024.mp3"
  },
  {
   "number": 25,
   "globalNumber": 6018,
   "juz": 30,
   "page": 594,
   "text": "فَيَوْمَئِذٍۢ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌۭ",
   "translation": "Maka pada hari itu tiada seorangpun yang menyiksa seperti siksa-Nya.",
   "tajweed": "فَيَوْمَئِ[u:10538[ذٍ ل]َّا يُعَذِّبُ عَذَابَهُ[o[ۥٓ] أَحَ[q[د]ٌ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/089025.mp3"
  },
  {
   "number": 26,
   "globalNumber": 6019,
   "juz": 30,
   "page": 594,
   "text": "وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌۭ",
   "translation": "dan tiada seorangpun yang mengikat seperti ikatan-Nya.",
   "tajweed": "وَلَا يُوثِقُ وَثَاقَهُ[o[ۥٓ] أَحَ[q[د]ٌ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/089026.mp3"
  },
  {
   "number": 27,
   "globalNumber": 6020,
   "juz": 30,
   "page": 594,
   "text": "يَٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ",
   "translation": "Hai jiwa yang tenang.",
   "tajweed": "يَ[o[ـٰٓ]أَيَّتُهَا [h:14494[ٱ][l[ل][g[نّ]َفْسُ [h:14495[ٱ]لْمُ[q:14496[طْ]مَئِ[g[نّ]َةُ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/089027.mp3"
  },
  {
   "number": 28,
   "globalNumber": 6021,
   "juz": 30,
   "page": 594,
   "text": "ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةًۭ مَّرْضِيَّةًۭ",
   "translation": "Kembalilah kepada Tuhanmu dengan hati yang puas lagi diridhai-Nya.",
   "tajweed": "ٱرْجِع[o[ِىٓ] إِلَىٰ رَبِّكِ رَاضِيَ[a:14497[ةً م]َّرْضِيَّةً",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/089028.mp3"
  },
  {
   "number": 29,
   "globalNumber": 6022,
   "juz": 30,
   "page": 594,
   "text": "فَٱدْخُلِى فِى عِبَٰدِى",
   "translation": "Maka masuklah ke dalam jama'ah hamba-hamba-Ku,",
   "tajweed": "فَ[h:9999[ٱ][q:14498[دْ]خُلِى فِى عِبَ[n[ـٰ]دِى",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/089029.mp3"
  },
  {
   "number": 30,
   "globalNumber": 6023,
   "juz": 30,
   "page": 594,
   "text": "وَٱدْخُلِى جَنَّتِى",
   "translation": "masuklah ke dalam surga-Ku.",
   "tajweed": "وَ[h:9999[ٱ][q:14499[دْ]خُلِى جَ[g[نّ]َتِى",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/089030.mp3"
  }
 ]
}
