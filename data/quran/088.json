{
 "number": 88,
 "name": "سُورَةُ الغَاشِيَةِ",
 "englishName": "Al-Ghaashiya",
 "englishNameTranslation": "The Overwhelming",
 "revelationType": "Meccan",
 "ayahCount": 26,
 "hasBasmalah": true,
 "ayahs": [
  {
   "number": 1,
   "globalNumber": 5968,
   "juz": 30,
   "page": 592,
   "text": "هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ",
   "translation": "Sudah datangkah kepadamu berita (tentang) hari pembalasan?",
   "tajweed": "هَلْ أَتَ[n[ـٰ]كَ حَدِيثُ [h:14451[ٱ]لْغَ[n[ـٰ]شِيَةِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/088001.mp3"
  },
  {
   "number": 2,
   "globalNumber": 5969,
   "juz": 30,
   "page": 592,
   "text": "وُجُوهٌۭ يَوْمَئِذٍ خَٰشِعَةٌ",
   "translation": "Banyak muka pada hari itu tunduk terhina,",
   "tajweed": "وُجُو[a:14135[هٌ ي]َوْمَئِذٍ خَ[n[ـٰ]شِعَةٌ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/088002.mp3"
  },
  {
   "number": 3,
   "globalNumber": 5970,
   "juz": 30,
   "page": 592,
   "text": "عَامِلَةٌۭ نَّاصِبَةٌۭ",
   "translation": "bekerja keras lagi kepayahan,",
   "tajweed": "عَامِلَ[a:14452[ةٌ ن]َّاصِبَةٌ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/088003.mp3"
  },
  {
   "number": 4,
   "globalNumber": 5971,
   "juz": 30,
   "page": 592,
   "text": "تَصْلَىٰ نَارًا حَامِيَةًۭ",
   "translation": "memasuki api yang sangat panas (neraka),",
   "tajweed": "تَصْلَىٰ نَارًا حَامِيَةً",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/088004.mp3"
  },
  {
   "number": 5,
   "globalNumber": 5972,
   "juz": 30,
   "page": 592,
   "text": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍۢ",
   "translation": "diberi minum (dengan air) dari sumber yang sangat panas.",
   "tajweed": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/088005.mp3"
  },
  {
   "number": 6,
   "globalNumber": 5973,
   "juz": 30,
   "page": 592,
   "text": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍۢ",
   "translation": "Mereka tiada memperoleh makanan selain dari pohon yang berduri,",
   "tajweed": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِ[f:14453[ن ض]َر[p[ِي]عٍ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/088006.mp3"
  },
  {
   "number": 7,
   "globalNumber": 5974,
   "juz": 30,
   "page": 592,
   "text": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍۢ",
   "translation": "yang tidak menggemukkan dan tidak pula menghilangkan lapar.",
   "tajweed": "لَّا يُسْمِنُ وَلَا يُغْنِى مِ[f:14454[ن ج][p[ُو]عٍ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/088007.mp3"
  },
  {
   "number": 8,
   "globalNumber": 5975,
   "juz": 30,
   "page": 592,
   "text": "وُجُوهٌۭ يَوْمَئِذٍۢ نَّاعِمَةٌۭ",
   "translation": "Banyak muka pada hari itu berseri-seri,",
   "tajweed": "وُجُو[a:14135[هٌ ي]َوْمَئِ[a:14455[ذٍ ن]َّاعِمَةٌ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/088008.mp3"
  },
  {
   "number": 9,
   "globalNumber": 5976,
   "juz": 30,
   "page": 592,
   "text": "لِّسَعْيِهَا رَاضِيَةٌۭ",
   "translation": "merasa senang karena usahanya,",
   "tajweed": "لِّسَعْيِهَا رَاضِيَةٌ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/088009.mp3"
  },
  {
   "number": 10,
   "globalNumber": 5977,
   "juz": 30,
   "page": 592,
   "text": "فِى جَنَّةٍ عَالِيَةٍۢ",
   "translation": "dalam surga yang tinggi,",
   "tajweed": "فِى جَ[g[نّ]َةٍ عَالِيَةٍ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/088010.mp3"
  },
  {
   "number": 11,
   "globalNumber": 5978,
   "juz": 30,
   "page": 592,
   "text": "لَّا تَسْمَعُ فِيهَا لَٰغِيَةًۭ",
   "translation": "tidak kamu dengar di dalamnya perkataan yang tidak berguna.",
   "tajweed": "لَّا تَسْمَعُ فِيهَا لَ[n[ـٰ]غِيَةً",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/088011.mp3"
  },
  {
   "number": 12,
   "globalNumber": 5979,
   "juz": 30,
   "page": 592,
   "text": "فِيهَا عَيْنٌۭ جَارِيَةٌۭ",
   "translation": "Di dalamnya ada mata air yang mengalir.",
   "tajweed": "فِيهَا عَيْ[f:14456[نٌ ج]َارِيَةٌ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/088012.mp3"
  },
  {
   "number": 13,
   "globalNumber": 5980,
   "juz": 30,
   "page": 592,
   "text": "فِيهَا سُرُرٌۭ مَّرْفُوعَةٌۭ",
   "translation": "Di dalamnya ada takhta-takhta yang ditinggikan,",
   "tajweed": "فِيهَا سُرُ[a:14457[رٌ م]َّرْفُوعَةٌ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/088013.mp3"
  },
  {
   "number": 14,
   "globalNumber": 5981,
   "juz": 30,
   "page": 592,
   "text": "وَأَكْوَابٌۭ مَّوْضُوعَةٌۭ",
   "translation": "dan gelas-gelas yang terletak (di dekatnya),",
   "tajweed": "وَأَكْوَا[a:14458[بٌ م]َّوْضُوعَةٌ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/088014.mp3"
  },
  {
   "number": 15,
   "globalNumber": 5982,
   "juz": 30,
   "page": 592,
   "text": "وَنَمَارِقُ مَصْفُوفَةٌۭ",
   "translation": "dan bantal-bantal sandaran yang tersusun,",
   "tajweed": "وَنَمَارِقُ مَصْفُوفَةٌ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/088015.mp3"
  },
  {
   "number": 16,
   "globalNumber": 5983,
   "juz": 30,
   "page": 592,
   "text": "وَزَرَابِىُّ مَبْثُوثَةٌ",
   "translation": "dan permadani-permadani yang terhampar.",
   "tajweed": "وَزَرَابِىُّ مَ[q:14459[بْ]ثُوثَةٌ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/088016.mp3"
  },
  {
   "number": 17,
   "globalNumber": 5984,
   "juz": 30,
   "page": 592,
   "text": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ",
   "translation": "Maka apakah mereka tidak memperhatikan unta bagaimana dia diciptakan,",
   "tajweed": "أَفَلَا يَ[f:1141[نظ]ُرُونَ إِلَى [h:14460[ٱ]لْإِبِلِ كَيْفَ خُلِقَتْ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/088017.mp3"
  },
  {
   "number": 18,
   "globalNumber": 5985,
   "juz": 30,
   "page": 592,
   "text": "وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ",
   "translation": "Dan langit, bagaimana ia ditinggikan?",
   "tajweed": "وَإِلَى [h:14461[ٱ][l[ل]سَّم[o[َا]ٓءِ كَيْفَ رُفِعَتْ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/088018.mp3"
  },
  {
   "number": 19,
   "globalNumber": 5986,
   "juz": 30,
   "page": 592,
   "text": "وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ",
   "translation": "Dan gunung-gunung bagaimana ia ditegakkan?",
   "tajweed": "وَإِلَى [h:14462[ٱ]لْجِبَالِ كَيْفَ نُصِبَتْ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/088019.mp3"
  },
  {
   "number": 20,
   "globalNumber": 5987,
   "juz": 30,
   "page": 592,
   "text": "وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ",
   "translation": "Dan bumi bagaimana ia dihamparkan?",
   "tajweed": "وَإِلَى [h:14463[ٱ]لْأَرْضِ كَيْفَ سُطِحَتْ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/088020.mp3"
  },
  {
   "number": 21,
   "globalNumber": 5988,
   "juz": 30,
   "page": 592,
   "text": "فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌۭ",
   "translation": "Maka berilah peringatan, karena sesungguhnya kamu hanyalah orang yang memberi peringatan.",
   "tajweed": "فَذَكِّرْ إِ[g[نّ]َم[o[َآ] أَ[f:169[نت]َ مُذَكِّرٌ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/088021.mp3"
  },
  {
   "number": 22,
   "globalNumber": 5989,
   "juz": 30,
   "page": 592,
   "text": "لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ",
   "translation": "Kamu bukanlah orang yang berkuasa atas mereka,",
   "tajweed": "لَّسْتَ عَلَيْه[c:14464[ِم ب]ِمُصَيْطِرٍ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/088022.mp3"
  },
  {
   "number": 23,
   "globalNumber": 5990,
   "juz": 30,
   "page": 592,
   "text": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ",
   "translation": "tetapi orang yang berpaling dan kafir,",
   "tajweed": "إِلَّا مَ[f:12995[ن ت]َوَلَّىٰ وَكَفَرَ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/088023.mp3"
  },
  {
   "number": 24,
   "globalNumber": 5991,
   "juz": 30,
   "page": 592,
   "text": "فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ",
   "translation": "maka Allah akan mengazabnya dengan azab yang besar.",
   "tajweed": "فَيُعَذِّبُهُ [h:14465[ٱ]للَّهُ [h:14466[ٱ]لْعَذَابَ [h:14467[ٱ]لْأَكْبَرَ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/088024.mp3"
  },
  {
   "number": 25,
   "globalNumber": 5992,
   "juz": 30,
   "page": 592,
   "text": "إِنَّ إِلَيْنَآ إِيَابَهُمْ",
   "translation": "Sesungguhnya kepada Kami-lah kembali mereka,",
   "tajweed": "إِ[g[نّ]َ إِلَيْن[o[َآ] إِيَابَهُمْ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/088025.mp3"
  },
  {
   "number": 26,
   "globalNumber": 5993,
   "juz": 30,
   "page": 592,
   "text": "ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم",
   "translation": "kemudian sesungguhnya kewajiban Kami-lah menghisab mereka.",
   "tajweed": "ثُ[g[مّ]َ إِ[g[نّ]َ عَلَيْنَا حِسَابَهُم",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/088026.mp3"
  }
 ]
}
