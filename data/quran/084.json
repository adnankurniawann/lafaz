{
 "number": 84,
 "name": "سُورَةُ الانشِقَاقِ",
 "englishName": "Al-Inshiqaaq",
 "englishNameTranslation": "The Splitting Open",
 "revelationType": "Meccan",
 "ayahCount": 25,
 "hasBasmalah": true,
 "ayahs": [
  {
   "number": 1,
   "globalNumber": 5885,
   "juz": 30,
   "page": 589,
   "text": "إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ",
   "translation": "Apabila langit terbelah,",
   "tajweed": "إِذَا [h:14351[ٱ][l[ل]سَّم[o[َا]ٓءُ [h:14390[ٱ][f:14391[نش]َقَّتْ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/084001.mp3"
  },
  {
   "number": 2,
   "globalNumber": 5886,
   "juz": 30,
   "page": 589,
   "text": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ",
   "translation": "dan patuh kepada Tuhannya, dan sudah semestinya langit itu patuh,",
   "tajweed": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/084002.mp3"
  },
  {
   "number": 3,
   "globalNumber": 5887,
   "juz": 30,
   "page": 589,
   "text": "وَإِذَا ٱلْأَرْضُ مُدَّتْ",
   "translation": "dan apabila bumi diratakan,",
   "tajweed": "وَإِذَا [h:14392[ٱ]لْأَرْضُ مُدَّتْ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/084003.mp3"
  },
  {
   "number": 4,
   "globalNumber": 5888,
   "juz": 30,
   "page": 589,
   "text": "وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ",
   "translation": "dan dilemparkan apa yang ada di dalamnya dan menjadi kosong,",
   "tajweed": "وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/084004.mp3"
  },
  {
   "number": 5,
   "globalNumber": 5889,
   "juz": 30,
   "page": 589,
   "text": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ",
   "translation": "dan patuh kepada Tuhannya, dan sudah semestinya bumi itu patuh, (pada waktu itu manusia akan mengetahui akibat perbuatannya).",
   "tajweed": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/084005.mp3"
  },
  {
   "number": 6,
   "globalNumber": 5890,
   "juz": 30,
   "page": 589,
   "text": "يَٰٓأَيُّهَا ٱلْإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًۭا فَمُلَٰقِيهِ",
   "translation": "Hai manusia, sesungguhnya kamu telah bekerja dengan sungguh-sungguh menuju Tuhanmu, maka pasti kamu akan menemui-Nya.",
   "tajweed": "يَ[o[ـٰٓ]أَيُّهَا [h:14358[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ إِ[g[نّ]َكَ كَادِحٌ إِلَىٰ رَبِّكَ كَ[q:14393[دْ][f:14394[حًا ف]َمُلَ[n[ـٰ]ق[p[ِي]هِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/084006.mp3"
  },
  {
   "number": 7,
   "globalNumber": 5891,
   "juz": 30,
   "page": 589,
   "text": "فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ",
   "translation": "Adapun orang yang diberikan kitabnya dari sebelah kanannya,",
   "tajweed": "فَأَ[g[مّ]َا مَنْ أُوتِىَ كِتَ[n[ـٰ]بَهُ[n[ۥ] بِيَمِينِهِۦ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/084007.mp3"
  },
  {
   "number": 8,
   "globalNumber": 5892,
   "juz": 30,
   "page": 589,
   "text": "فَسَوْفَ يُحَاسَبُ حِسَابًۭا يَسِيرًۭا",
   "translation": "maka dia akan diperiksa dengan pemeriksaan yang mudah,",
   "tajweed": "فَسَوْفَ يُحَاسَبُ حِسَا[a:14395[بًا ي]َسِيرًا",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/084008.mp3"
  },
  {
   "number": 9,
   "globalNumber": 5893,
   "juz": 30,
   "page": 589,
   "text": "وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًۭا",
   "translation": "dan dia akan kembali kepada kaumnya (yang sama-sama beriman) dengan gembira.",
   "tajweed": "وَيَ[f:14396[نق]َلِبُ إِلَ[o[ىٰٓ] أَهْلِه[n[ِۦ] مَسْرُورًا",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/084009.mp3"
  },
  {
   "number": 10,
   "globalNumber": 5894,
   "juz": 30,
   "page": 589,
   "text": "وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ",
   "translation": "Adapun orang-orang yang diberikan kitabnya dari belakang,",
   "tajweed": "وَأَ[g[مّ]َا مَنْ أُوتِىَ كِتَ[n[ـٰ]بَهُ[n[ۥ] وَر[o[َا]ٓءَ ظَهْرِهِۦ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/084010.mp3"
  },
  {
   "number": 11,
   "globalNumber": 5895,
   "juz": 30,
   "page": 589,
   "text": "فَسَوْفَ يَدْعُوا۟ ثُبُورًۭا",
   "translation": "maka dia akan berteriak: \"Celakalah aku\".",
   "tajweed": "فَسَوْفَ يَ[q:1242[دْ]عُو[s[اْ] ثُبُورًا",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/084011.mp3"
  },
  {
   "number": 12,
   "globalNumber": 5896,
   "juz": 30,
   "page": 589,
   "text": "وَيَصْلَىٰ سَعِيرًا",
   "translation": "Dan dia akan masuk ke dalam api yang menyala-nyala (neraka).",
   "tajweed": "وَيَصْلَىٰ سَعِيرًا",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/084012.mp3"
  },
  {
   "number": 13,
   "globalNumber": 5897,
   "juz": 30,
   "page": 589,
   "text": "إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا",
   "translation": "Sesungguhnya dia dahulu (di dunia) bergembira di kalangan kaumnya (yang sama-sama kafir).",
   "tajweed": "إِ[g[نّ]َهُ[n[ۥ] كَانَ ف[o[ِىٓ] أَهْلِه[n[ِۦ] مَسْرُورًا",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/084013.mp3"
  },
  {
   "number": 14,
   "globalNumber": 5898,
   "juz": 30,
   "page": 589,
   "text": "إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ",
   "translation": "Sesungguhnya dia menyangka bahwa dia sekali-kali tidak akan kembali (kepada Tuhannya).",
   "tajweed": "إِ[g[نّ]َهُ[n[ۥ] ظَ[g[نّ]َ أ[u:8842[َن ل]ّ[a:14397[َن ي]َح[p[ُو]رَ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/084014.mp3"
  },
  {
   "number": 15,
   "globalNumber": 5899,
   "juz": 30,
   "page": 589,
   "text": "بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًۭا",
   "translation": "(Bukan demikian), yang benar, sesungguhnya Tuhannya selalu melihatnya.",
   "tajweed": "بَلَ[o[ىٰٓ] إِ[g[نّ]َ رَبَّهُ[n[ۥ] كَانَ بِه[n[ِۦ] بَصِيرًا",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/084015.mp3"
  },
  {
   "number": 16,
   "globalNumber": 5900,
   "juz": 30,
   "page": 589,
   "text": "فَلَآ أُقْسِمُ بِٱلشَّفَقِ",
   "translation": "Maka sesungguhnya Aku bersumpah dengan cahaya merah di waktu senja,",
   "tajweed": "فَل[o[َآ] أُ[q:13287[قْ]سِمُ بِ[h:14398[ٱ][l[ل]شَّفَ[q[ق]ِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/084016.mp3"
  },
  {
   "number": 17,
   "globalNumber": 5901,
   "juz": 30,
   "page": 589,
   "text": "وَٱلَّيْلِ وَمَا وَسَقَ",
   "translation": "dan dengan malam dan apa yang diselubunginya,",
   "tajweed": "وَ[h:9999[ٱ]لَّيْلِ وَمَا وَسَ[q[ق]َ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/084017.mp3"
  },
  {
   "number": 18,
   "globalNumber": 5902,
   "juz": 30,
   "page": 589,
   "text": "وَٱلْقَمَرِ إِذَا ٱتَّسَقَ",
   "translation": "dan dengan bulan apabila jadi purnama,",
   "tajweed": "وَ[h:9999[ٱ]لْقَمَرِ إِذَا [h:14399[ٱ]تَّسَ[q[ق]َ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/084018.mp3"
  },
  {
   "number": 19,
   "globalNumber": 5903,
   "juz": 30,
   "page": 589,
   "text": "لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍۢ",
   "translation": "sesungguhnya kamu melalui tingkat demi tingkat (dalam kehidupan),",
   "tajweed": "لَتَرْكَبُ[g[نّ]َ طَبَقًا عَ[f:14400[ن ط]َبَ[q[ق]ٍ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/084019.mp3"
  },
  {
   "number": 20,
   "globalNumber": 5904,
   "juz": 30,
   "page": 589,
   "text": "فَمَا لَهُمْ لَا يُؤْمِنُونَ",
   "translation": "Mengapa mereka tidak mau beriman?",
   "tajweed": "فَمَا لَهُمْ لَا يُؤْمِن[p[ُو]نَ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/084020.mp3"
  },
  {
   "number": 21,
   "globalNumber": 5905,
   "juz": 30,
   "page": 589,
   "text": "وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ ۩",
   "translation": "dan apabila Al Quran dibacakan kepada mereka, mereka tidak bersujud,",
   "tajweed": "وَإِذَا قُرِئَ عَلَيْهِمُ [h:14401[ٱ]لْقُرْءَانُ لَا يَسْجُدُ[p[و]نَ ۩",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/084021.mp3"
  },
  {
   "number": 22,
   "globalNumber": 5906,
   "juz": 30,
   "page": 589,
   "text": "بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ",
   "translation": "bahkan orang-orang kafir itu mendustakan(nya).",
   "tajweed": "بَلِ [h:10932[ٱ]لَّذِينَ كَفَرُو[s[اْ] يُكَذِّب[p[ُو]نَ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/084022.mp3"
  },
  {
   "number": 23,
   "globalNumber": 5907,
   "juz": 30,
   "page": 589,
   "text": "وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ",
   "translation": "Padahal Allah mengetahui apa yang mereka sembunyikan (dalam hati mereka).",
   "tajweed": "وَ[h:9999[ٱ]للَّهُ أَعْلَمُ بِمَا يُوع[p[ُو]نَ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/084023.mp3"
  },
  {
   "number": 24,
   "globalNumber": 5908,
   "juz": 30,
   "page": 589,
   "text": "فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ",
   "translation": "Maka beri kabar gembiralah mereka dengan azab yang pedih,",
   "tajweed": "فَبَشِّرْه[c:1811[ُم ب]ِعَذَابٍ أَل[p[ِي]مٍ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/084024.mp3"
  },
  {
   "number": 25,
   "globalNumber": 5909,
   "juz": 30,
   "page": 589,
   "text": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ",
   "translation": "tetapi orang-orang yang beriman dan beramal saleh, bagi mereka pahala yang tidak putus-putusnya.",
   "tajweed": "إِلَّا [h:778[ٱ]لَّذِينَ ءَامَنُو[s[اْ] وَعَمِلُو[s[اْ] [h:118[ٱ][l[ل]صَّ[n[ـٰ]لِحَ[n[ـٰ]تِ لَهُمْ أَ[q:2423[جْ]رٌ غَيْرُ مَمْن[p[ُو]نِۭ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/084025.mp3"
  }
 ]
}
