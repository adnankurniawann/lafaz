  },
  {
   "number": 3,
   "globalNumber": 6171,
   "juz": 30,
   "page": 600,
   "text": "كَلَّا سَوْفَ تَعْلَمُونَ",
   "translation": "Janganlah begitu, kelak kamu akan mengetahui (akibat perbuatanmu itu),",
   "tajweed": "كَلَّا سَوْفَ تَعْلَم[p[ُو]نَ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/102003.mp3"
  },
  {
   "number": 4,
   "globalNumber": 6172,
   "juz": 30,
   "page": 600,
   "text": "ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ",
   "translation": "dan janganlah begitu, kelak kamu akan mengetahui.",
   "tajweed": "ثُ[g[مّ]َ كَلَّا سَوْفَ تَعْلَم[p[ُو]نَ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/102004.mp3"
  },
  {
   "number": 5,
   "globalNumber": 6173,
   "juz": 30,
   "page": 600,
   "text": "كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ",
   "translation": "Janganlah begitu, jika kamu mengetahui dengan pengetahuan yang yakin,",
   "tajweed": "كَلَّا لَوْ تَعْلَمُونَ عِلْمَ [h:14629[ٱ]لْيَق[p[ِي]نِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/102005.mp3"
  },
  {
   "number": 6,
   "globalNumber": 6174,
   "juz": 30,
   "page": 600,
   "text": "لَتَرَوُنَّ ٱلْجَحِيمَ",
   "translation": "niscaya kamu benar-benar akan melihat neraka Jahiim,",
   "tajweed": "لَتَرَوُ[g[نّ]َ [h:14630[ٱ]لْجَح[p[ِي]مَ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/102006.mp3"
  },
  {
   "number": 7,
   "globalNumber": 6175,
   "juz": 30,
   "page": 600,
   "text": "ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ",
   "translation": "dan sesungguhnya kamu benar-benar akan melihatnya dengan 'ainul yaqin.",
   "tajweed": "ثُ[g[مّ]َ لَتَرَوُ[g[نّ]َهَا عَيْنَ [h:14631[ٱ]لْيَق[p[ِي]نِ",
