{
 "number": 81,
 "name": "سُورَةُ التَّكۡوِيرِ",
 "englishName": "At-Takwir",
 "englishNameTranslation": "The Overthrowing",
 "revelationType": "Meccan",
 "ayahCount": 29,
 "hasBasmalah": true,
 "ayahs": [
  {
   "number": 1,
   "globalNumber": 5801,
   "juz": 30,
   "page": 586,
   "text": "إِذَا ٱلشَّمْسُ كُوِّرَتْ",
   "translation": "Apabila matahari digulung,",
   "tajweed": "إِذَا [h:14331[ٱ][l[ل]شَّمْسُ كُوِّرَتْ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/081001.mp3"
  },
  {
   "number": 2,
   "globalNumber": 5802,
   "juz": 30,
   "page": 586,
   "text": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ",
   "translation": "dan apabila bintang-bintang berjatuhan,",
   "tajweed": "وَإِذَا [h:14332[ٱ][l[ل][g[نّ]ُجُومُ [h:14333[ٱ][f:14334[نك]َدَرَتْ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/081002.mp3"
  },
  {
   "number": 3,
   "globalNumber": 5803,
   "juz": 30,
   "page": 586,
   "text": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ",
   "translation": "dan apabila gunung-gunung dihancurkan,",
   "tajweed": "وَإِذَا [h:14211[ٱ]لْجِبَالُ سُيِّرَتْ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/081003.mp3"
  },
  {
   "number": 4,
   "globalNumber": 5804,
   "juz": 30,
   "page": 586,
   "text": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ",
   "translation": "dan apabila unta-unta yang bunting ditinggalkan (tidak diperdulikan)",
   "tajweed": "وَإِذَا [h:14335[ٱ]لْعِشَارُ عُطِّلَتْ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/081004.mp3"
  },
  {
   "number": 5,
   "globalNumber": 5805,
   "juz": 30,
   "page": 586,
   "text": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ",
   "translation": "dan apabila binatang-binatang liar dikumpulkan,",
   "tajweed": "وَإِذَا [h:14336[ٱ]لْوُحُوشُ حُشِرَتْ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/081005.mp3"
  },
  {
   "number": 6,
   "globalNumber": 5806,
   "juz": 30,
   "page": 586,
   "text": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ",
   "translation": "dan apabila lautan dijadikan meluap",
   "tajweed": "وَإِذَا [h:14337[ٱ]لْبِحَارُ سُجِّرَتْ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/081006.mp3"
  },
  {
   "number": 7,
   "globalNumber": 5807,
   "juz": 30,
   "page": 586,
   "text": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ",
   "translation": "dan apabila ruh-ruh dipertemukan (dengan tubuh)",
   "tajweed": "وَإِذَا [h:14338[ٱ][l[ل][g[نّ]ُفُوسُ زُوِّجَتْ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/081007.mp3"
  },
  {
   "number": 8,
   "globalNumber": 5808,
   "juz": 30,
   "page": 586,
   "text": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ",
   "translation": "dan apabila bayi-bayi perempuan yang dikubur hidup-hidup ditanya,",
   "tajweed": "وَإِذَا [h:14339[ٱ]لْمَوْءُ[n[ۥ]دَةُ سُئِلَتْ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/081008.mp3"
  },
  {
   "number": 9,
   "globalNumber": 5809,
   "juz": 30,
   "page": 586,
   "text": "بِأَىِّ ذَنۢبٍۢ قُتِلَتْ",
   "translation": "karena dosa apakah dia dibunuh,",
   "tajweed": "بِأَىِّ ذَ[i:14340[نۢب][f:14341[ٍ ق]ُتِلَتْ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/081009.mp3"
  },
  {
   "number": 10,
   "globalNumber": 5810,
   "juz": 30,
   "page": 586,
   "text": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ",
   "translation": "dan apabila catatan-catatan (amal perbuatan manusia) dibuka,",
   "tajweed": "وَإِذَا [h:14342[ٱ][l[ل]صُّحُفُ نُشِرَتْ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/081010.mp3"
  },
  {
   "number": 11,
   "globalNumber": 5811,
   "juz": 30,
   "page": 586,
   "text": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ",
   "translation": "dan apabila langit dilenyapkan,",
   "tajweed": "وَإِذَا [h:14210[ٱ][l[ل]سَّم[o[َا]ٓءُ كُشِطَتْ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/081011.mp3"
  },
  {
   "number": 12,
   "globalNumber": 5812,
   "juz": 30,
   "page": 586,
   "text": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ",
   "translation": "dan apabila neraka Jahim dinyalakan,",
   "tajweed": "وَإِذَا [h:14343[ٱ]لْجَحِيمُ سُعِّرَتْ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/081012.mp3"
  },
  {
   "number": 13,
   "globalNumber": 5813,
   "juz": 30,
   "page": 586,
   "text": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ",
   "translation": "dan apabila surga didekatkan,",
   "tajweed": "وَإِذَا [h:14344[ٱ]لْجَ[g[نّ]َةُ أُزْلِفَتْ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/081013.mp3"
  },
  {
   "number": 14,
   "globalNumber": 5814,
   "juz": 30,
   "page": 586,
   "text": "عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ",
   "translation": "maka tiap-tiap jiwa akan mengetahui apa yang telah dikerjakannya.",
   "tajweed": "عَلِمَتْ نَفْ[a:10644[سٌ م]ّ[o[َآ] أَحْضَرَتْ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/081014.mp3"
  },
  {
   "number": 15,
   "globalNumber": 5815,
   "juz": 30,
   "page": 586,
   "text": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ",
   "translation": "Sungguh, Aku bersumpah dengan bintang-bintang,",
   "tajweed": "فَل[o[َآ] أُ[q:13287[قْ]سِمُ بِ[h:14345[ٱ]لْخُ[g[نّ]َسِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/081015.mp3"
  },
  {
   "number": 16,
   "globalNumber": 5816,
   "juz": 30,
   "page": 586,
   "text": "ٱلْجَوَارِ ٱلْكُنَّسِ",
   "translation": "yang beredar dan terbenam,",
   "tajweed": "ٱلْجَوَارِ [h:14346[ٱ]لْكُ[g[نّ]َسِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/081016.mp3"
  },
  {
   "number": 17,
   "globalNumber": 5817,
   "juz": 30,
   "page": 586,
   "text": "وَٱلَّيْلِ إِذَا عَسْعَسَ",
   "translation": "demi malam apabila telah hampir meninggalkan gelapnya,",
   "tajweed": "وَ[h:9999[ٱ]لَّيْلِ إِذَا عَسْعَسَ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/081017.mp3"
  },
  {
   "number": 18,
   "globalNumber": 5818,
   "juz": 30,
   "page": 586,
   "text": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ",
   "translation": "dan demi subuh apabila fajarnya mulai menyingsing,",
   "tajweed": "وَ[h:9999[ٱ][l[ل]صُّ[q:14092[بْ]حِ إِذَا تَنَفَّسَ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/081018.mp3"
  },
  {
   "number": 19,
   "globalNumber": 5819,
   "juz": 30,
   "page": 586,
   "text": "إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ",
   "translation": "sesungguhnya Al Quran itu benar-benar firman (Allah yang dibawa oleh) utusan yang mulia (Jibril),",
   "tajweed": "إِ[g[نّ]َهُ[n[ۥ] لَقَوْلُ رَسُو[f:13904[لٍ ك]َر[p[ِي]مٍ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/081019.mp3"
  },
  {
   "number": 20,
   "globalNumber": 5820,
   "juz": 30,
   "page": 586,
   "text": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ",
   "translation": "yang mempunyai kekuatan, yang mempunyai kedudukan tinggi di sisi Allah yang mempunyai 'Arsy,",
   "tajweed": "ذِى قُوَّةٍ عِ[f:264[ند]َ ذِى [h:7769[ٱ]لْعَرْشِ مَك[p[ِي]نٍ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/081020.mp3"
  },
  {
   "number": 21,
   "globalNumber": 5821,
   "juz": 30,
   "page": 586,
   "text": "مُّطَاعٍۢ ثَمَّ أَمِينٍۢ",
   "translation": "yang ditaati di sana (di alam malaikat) lagi dipercaya.",
   "tajweed": "مُّطَا[f:14347[عٍ ث]َ[g[مّ]َ أَم[p[ِي]نٍ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/081021.mp3"
  },
  {
   "number": 22,
   "globalNumber": 5822,
   "juz": 30,
   "page": 586,
   "text": "وَمَا صَاحِبُكُم بِمَجْنُونٍۢ",
   "translation": "Dan temanmu (Muhammad) itu bukanlah sekali-kali orang yang gila.",
   "tajweed": "وَمَا صَاحِبُك[c:14348[ُم ب]ِمَ[q:13812[جْ]ن[p[ُو]نٍ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/081022.mp3"
  },
  {
   "number": 23,
   "globalNumber": 5823,
   "juz": 30,
   "page": 586,
   "text": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ",
   "translation": "Dan sesungguhnya Muhammad itu melihat Jibril di ufuk yang terang.",
   "tajweed": "وَلَقَ[q:341[دْ] رَءَاهُ بِ[h:12961[ٱ]لْأُفُقِ [h:14349[ٱ]لْمُب[p[ِي]نِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/081023.mp3"
  },
  {
   "number": 24,
   "globalNumber": 5824,
   "juz": 30,
   "page": 586,
   "text": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ",
   "translation": "Dan dia (Muhammad) bukanlah orang yang bakhil untuk menerangkan yang ghaib.",
   "tajweed": "وَمَا هُوَ عَلَى [h:2453[ٱ]لْغَيْبِ بِضَن[p[ِي]نٍ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/081024.mp3"
  },
  {
   "number": 25,
   "globalNumber": 5825,
   "juz": 30,
   "page": 586,
   "text": "وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍۢ رَّجِيمٍۢ",
   "translation": "Dan Al Quran itu bukanlah perkataan syaitan yang terkutuk,",
   "tajweed": "وَمَا هُوَ بِقَوْلِ شَيْطَ[n[ـٰ][u:7213[نٍ ر]َّج[p[ِي]مٍ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/081025.mp3"
  },
  {
   "number": 26,
   "globalNumber": 5826,
   "juz": 30,
   "page": 586,
   "text": "فَأَيْنَ تَذْهَبُونَ",
   "translation": "maka ke manakah kamu akan pergi?",
   "tajweed": "فَأَيْنَ تَذْهَب[p[ُو]نَ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/081026.mp3"
  },
  {
   "number": 27,
   "globalNumber": 5827,
   "juz": 30,
   "page": 586,
   "text": "إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ",
   "translation": "Al Quran itu tiada lain hanyalah peringatan bagi semesta alam,",
   "tajweed": "إِنْ هُوَ إِلَّا ذِكْ[u:6839[رٌ ل]ِّلْعَ[n[ـٰ]لَم[p[ِي]نَ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/081027.mp3"
  },
  {
   "number": 28,
   "globalNumber": 5828,
   "juz": 30,
   "page": 586,
   "text": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ",
   "translation": "(yaitu) bagi siapa di antara kamu yang mau menempuh jalan yang lurus.",
   "tajweed": "لِمَ[f:14095[ن ش][o[َا]ٓءَ مِ[f:344[نك]ُمْ أ[a:14350[َن ي]َسْتَق[p[ِي]مَ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/081028.mp3"
  },
  {
   "number": 29,
   "globalNumber": 5829,
   "juz": 30,
   "page": 586,
   "text": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ",
   "translation": "Dan kamu tidak dapat menghendaki (menempuh jalan itu) kecuali apabila dikehendaki Allah, Tuhan semesta alam.",
   "tajweed": "وَمَا تَش[o[َا]ٓءُونَ إِلّ[o[َآ] أ[a:4201[َن ي]َش[o[َا]ٓءَ [h:4334[ٱ]للَّهُ رَبُّ [h:4750[ٱ]لْعَ[n[ـٰ]لَم[p[ِي]نَ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/081029.mp3"
  }
 ]
}
