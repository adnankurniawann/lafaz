{
 "number": 85,
 "name": "سُورَةُ البُرُوجِ",
 "englishName": "Al-Burooj",
 "englishNameTranslation": "The Constellations",
 "revelationType": "Meccan",
 "ayahCount": 22,
 "hasBasmalah": true,
 "ayahs": [
  {
   "number": 1,
   "globalNumber": 5910,
   "juz": 30,
   "page": 590,
   "text": "وَٱلسَّمَآءِ ذَاتِ ٱلْبُرُوجِ",
   "translation": "Demi langit yang mempunyai gugusan bintang,",
   "tajweed": "وَ[h:9999[ٱ][l[ل]سَّم[o[َا]ٓءِ ذَاتِ [h:14402[ٱ]لْبُر[p[ُو][q[ج]ِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/085001.mp3"
  },
  {
   "number": 2,
   "globalNumber": 5911,
   "juz": 30,
   "page": 590,
   "text": "وَٱلْيَوْمِ ٱلْمَوْعُودِ",
   "translation": "dan hari yang dijanjikan,",
   "tajweed": "وَ[h:9999[ٱ]لْيَوْمِ [h:14403[ٱ]لْمَوْع[p[ُو][q[د]ِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/085002.mp3"
  },
  {
   "number": 3,
   "globalNumber": 5912,
   "juz": 30,
   "page": 590,
   "text": "وَشَاهِدٍۢ وَمَشْهُودٍۢ",
   "translation": "dan yang menyaksikan dan yang disaksikan.",
   "tajweed": "وَشَاهِ[a:14404[دٍ و]َمَشْه[p[ُو][q[د]ٍ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/085003.mp3"
  },
  {
   "number": 4,
   "globalNumber": 5913,
   "juz": 30,
   "page": 590,
   "text": "قُتِلَ أَصْحَٰبُ ٱلْأُخْدُودِ",
   "translation": "Binasa dan terlaknatlah orang-orang yang membuat parit,",
   "tajweed": "قُتِلَ أَصْحَ[n[ـٰ]بُ [h:14405[ٱ]لْأُخْد[p[ُو][q[د]ِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/085004.mp3"
  },
  {
   "number": 5,
   "globalNumber": 5914,
   "juz": 30,
   "page": 590,
   "text": "ٱلنَّارِ ذَاتِ ٱلْوَقُودِ",
   "translation": "yang berapi (dinyalakan dengan) kayu bakar,",
   "tajweed": "ٱ[l[ل][g[نّ]َارِ ذَاتِ [h:14406[ٱ]لْوَق[p[ُو][q[د]ِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/085005.mp3"
  },
  {
   "number": 6,
   "globalNumber": 5915,
   "juz": 30,
   "page": 590,
   "text": "إِذْ هُمْ عَلَيْهَا قُعُودٌۭ",
   "translation": "ketika mereka duduk di sekitarnya,",
   "tajweed": "إِذْ هُمْ عَلَيْهَا قُع[p[ُو][q[د]ٌ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/085006.mp3"
  },
  {
   "number": 7,
   "globalNumber": 5916,
   "juz": 30,
   "page": 590,
   "text": "وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِٱلْمُؤْمِنِينَ شُهُودٌۭ",
   "translation": "sedang mereka menyaksikan apa yang mereka perbuat terhadap orang-orang yang beriman.",
   "tajweed": "وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِ[h:3560[ٱ]لْمُؤْمِنِينَ شُه[p[ُو][q[د]ٌ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/085007.mp3"
  },
  {
   "number": 8,
   "globalNumber": 5917,
   "juz": 30,
   "page": 590,
   "text": "وَمَا نَقَمُوا۟ مِنْهُمْ إِلَّآ أَن يُؤْمِنُوا۟ بِٱللَّهِ ٱلْعَزِيزِ ٱلْحَمِيدِ",
   "translation": "Dan mereka tidak menyiksa orang-orang mukmin itu melainkan karena orang-orang mukmin itu beriman kepada Allah Yang Maha Perkasa lagi Maha Terpuji,",
   "tajweed": "وَمَا نَقَمُو[s[اْ] مِنْهُمْ إِلّ[o[َآ] أ[a:386[َن ي]ُؤْمِنُو[s[اْ] بِ[h:32[ٱ]للَّهِ [h:14407[ٱ]لْعَزِيزِ [h:7037[ٱ]لْحَم[p[ِي][q[د]ِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/085008.mp3"
  },
  {
   "number": 9,
   "globalNumber": 5918,
   "juz": 30,
   "page": 590,
   "text": "ٱلَّذِى لَهُۥ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ ۚ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍۢ شَهِيدٌ",
   "translation": "Yang mempunyai kerajaan langit dan bumi; dan Allah Maha Menyaksikan segala sesuatu.",
   "tajweed": "ٱلَّذِى لَهُ[n[ۥ] مُلْكُ [h:555[ٱ][l[ل]سَّمَ[n[ـٰ]و[n[َٲ]تِ وَ[h:177[ٱ]لْأَرْضِ‌ۚ وَ[h:72[ٱ]للَّهُ عَلَىٰ كُلِّ ش[f:3903[َىْءٍ ش]َه[p[ِي][q[د]ٌ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/085009.mp3"
  },
  {
   "number": 10,
   "globalNumber": 5919,
   "juz": 30,
   "page": 590,
   "text": "إِنَّ ٱلَّذِينَ فَتَنُوا۟ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَٰتِ ثُمَّ لَمْ يَتُوبُوا۟ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ ٱلْحَرِيقِ",
   "translation": "Sesungguhnya orang-orang yang mendatangkan cobaan kepada orang-orang yang mukmin laki-laki dan perempuan kemudian mereka tidak bertaubat, maka bagi mereka azab Jahannam dan bagi mereka azab (neraka) yang membakar.",
   "tajweed": "إِ[g[نّ]َ [h:24[ٱ]لَّذِينَ فَتَنُو[s[اْ] [h:14408[ٱ]لْمُؤْمِنِينَ وَ[h:5718[ٱ]لْمُؤْمِنَ[n[ـٰ]تِ ثُ[g[مّ]َ لَمْ يَتُوبُو[s[اْ] فَلَهُمْ عَذَابُ جَهَ[g[نّ]َمَ وَلَهُمْ عَذَابُ [h:14409[ٱ]لْحَر[p[ِي][q[ق]ِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/085010.mp3"
  },
  {
   "number": 11,
   "globalNumber": 5920,
   "juz": 30,
   "page": 590,
   "text": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ جَنَّٰتٌۭ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ ۚ ذَٰلِكَ ٱلْفَوْزُ ٱلْكَبِيرُ",
   "translation": "Sesungguhnya orang-orang yang beriman dan mengerjakan amal-amal yang saleh bagi mereka surga yang mengalir di bawahnya sungai-sungai; itulah keberuntungan yang besar.",
   "tajweed": "إِ[g[نّ]َ [h:24[ٱ]لَّذِينَ ءَامَنُو[s[اْ] وَعَمِلُو[s[اْ] [h:118[ٱ][l[ل]صَّ[n[ـٰ]لِحَ[n[ـٰ]تِ لَهُمْ جَ[g[نّ]َ[n[ـٰ][f:1786[تٌ ت]َ[q:120[جْ]رِى مِ[f:121[ن ت]َحْتِهَا [h:122[ٱ]لْأَنْهَ[n[ـٰ]رُ‌ۚ ذ[n[َٲ]لِكَ [h:3911[ٱ]لْفَوْزُ [h:14410[ٱ]لْكَب[p[ِي]رُ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/085011.mp3"
  },
  {
   "number": 12,
   "globalNumber": 5921,
   "juz": 30,
   "page": 590,
   "text": "إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌ",
   "translation": "Sesungguhnya azab Tuhanmu benar-benar keras.",
   "tajweed": "إِ[g[نّ]َ بَ[q:14411[طْ]شَ رَبِّكَ لَشَد[p[ِي][q[د]ٌ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/085012.mp3"
  },
  {
   "number": 13,
   "globalNumber": 5922,
   "juz": 30,
   "page": 590,
   "text": "إِنَّهُۥ هُوَ يُبْدِئُ وَيُعِيدُ",
   "translation": "Sesungguhnya Dialah Yang menciptakan (makhluk) dari permulaan dan menghidupkannya (kembali).",
   "tajweed": "إِ[g[نّ]َهُ[n[ۥ] هُوَ يُ[q:10320[بْ]دِئُ وَيُع[p[ِي][q[د]ُ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/085013.mp3"
  },
  {
   "number": 14,
   "globalNumber": 5923,
   "juz": 30,
   "page": 590,
   "text": "وَهُوَ ٱلْغَفُورُ ٱلْوَدُودُ",
   "translation": "Dialah Yang Maha Pengampun lagi Maha Pengasih,",
   "tajweed": "وَهُوَ [h:6227[ٱ]لْغَفُورُ [h:14412[ٱ]لْوَد[p[ُو][q[د]ُ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/085014.mp3"
  },
  {
   "number": 15,
   "globalNumber": 5924,
   "juz": 30,
   "page": 590,
   "text": "ذُو ٱلْعَرْشِ ٱلْمَجِيدُ",
   "translation": "yang mempunyai 'Arsy, lagi Maha Mulia,",
   "tajweed": "ذُو [h:11807[ٱ]لْعَرْشِ [h:14413[ٱ]لْمَج[p[ِي][q[د]ُ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/085015.mp3"
  },
  {
   "number": 16,
   "globalNumber": 5925,
   "juz": 30,
   "page": 590,
   "text": "فَعَّالٌۭ لِّمَا يُرِيدُ",
   "translation": "Maha Kuasa berbuat apa yang dikehendaki-Nya.",
   "tajweed": "فَعَّا[u:6506[لٌ ل]ِّمَا يُر[p[ِي][q[د]ُ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/085016.mp3"
  },
  {
   "number": 17,
   "globalNumber": 5926,
   "juz": 30,
   "page": 590,
   "text": "هَلْ أَتَىٰكَ حَدِيثُ ٱلْجُنُودِ",
   "translation": "Sudahkah datang kepadamu berita kaum-kaum penentang,",
   "tajweed": "هَلْ أَتَ[n[ـٰ]كَ حَدِيثُ [h:14414[ٱ]لْجُن[p[ُو][q[د]ِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/085017.mp3"
  },
  {
   "number": 18,
   "globalNumber": 5927,
   "juz": 30,
   "page": 590,
   "text": "فِرْعَوْنَ وَثَمُودَ",
   "translation": "(yaitu kaum) Fir'aun dan (kaum) Tsamud?",
   "tajweed": "فِرْعَوْنَ وَثَم[p[ُو][q[د]َ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/085018.mp3"
  },
  {
   "number": 19,
   "globalNumber": 5928,
   "juz": 30,
   "page": 590,
   "text": "بَلِ ٱلَّذِينَ كَفَرُوا۟ فِى تَكْذِيبٍۢ",
   "translation": "Sesungguhnya orang-orang kafir selalu mendustakan,",
   "tajweed": "بَلِ [h:10932[ٱ]لَّذِينَ كَفَرُو[s[اْ] فِى تَكْذ[p[ِي][q[ب]ٍ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/085019.mp3"
  },
  {
   "number": 20,
   "globalNumber": 5929,
   "juz": 30,
   "page": 590,
   "text": "وَٱللَّهُ مِن وَرَآئِهِم مُّحِيطٌۢ",
   "translation": "padahal Allah mengepung mereka dari belakang mereka.",
   "tajweed": "وَ[h:9999[ٱ]للَّهُ م[a:12394[ِن و]َر[o[َا]ٓئِه[w:14415[ِم م]ُّح[p[ِي][q[ط]ُۢ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/085020.mp3"
  },
  {
   "number": 21,
   "globalNumber": 5930,
   "juz": 30,
   "page": 590,
   "text": "بَلْ هُوَ قُرْءَانٌۭ مَّجِيدٌۭ",
   "translation": "Bahkan yang didustakan mereka itu ialah Al Quran yang mulia,",
   "tajweed": "بَلْ هُوَ قُرْءَا[a:14416[نٌ م]َّج[p[ِي][q[د]ٌ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/085021.mp3"
  },
  {
   "number": 22,
   "globalNumber": 5931,
   "juz": 30,
   "page": 590,
   "text": "فِى لَوْحٍۢ مَّحْفُوظٍۭ",
   "translation": "yang (tersimpan) dalam Lauh Mahfuzh.",
   "tajweed": "فِى لَوْ[a:14417[حٍ م]َّحْف[p[ُو]ظِۭ",
