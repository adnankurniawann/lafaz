{
 "number": 96,
 "name": "سُورَةُ العَلَقِ",
 "englishName": "Al-Alaq",
 "englishNameTranslation": "The Clot",
 "revelationType": "Meccan",
 "ayahCount": 19,
 "hasBasmalah": true,
 "ayahs": [
  {
   "number": 1,
   "globalNumber": 6107,
   "juz": 30,
   "page": 597,
   "text": "ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ",
   "translation": "Bacalah dengan (menyebut) nama Tuhanmu Yang menciptakan,",
   "tajweed": "ٱ[q:7699[قْ]رَأْ بِ[h:13285[ٱ]سْمِ رَبِّكَ [h:14559[ٱ]لَّذِى خَلَ[q[ق]َ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/096001.mp3"
  },
  {
   "number": 2,
   "globalNumber": 6108,
   "juz": 30,
   "page": 597,
   "text": "خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ",
   "translation": "Dia telah menciptakan manusia dari segumpal darah.",
   "tajweed": "خَلَقَ [h:7324[ٱ]لْإِ[f:5969[نس]َ[n[ـٰ]نَ مِنْ عَلَ[q[ق]ٍ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/096002.mp3"
  },
  {
   "number": 3,
   "globalNumber": 6109,
   "juz": 30,
   "page": 597,
   "text": "ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ",
   "translation": "Bacalah, dan Tuhanmulah Yang Maha Pemurah,",
   "tajweed": "ٱ[q:7699[قْ]رَأْ وَرَبُّكَ [h:14560[ٱ]لْأَكْرَمُ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/096003.mp3"
  },
  {
   "number": 4,
   "globalNumber": 6110,
   "juz": 30,
   "page": 597,
   "text": "ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ",
   "translation": "Yang mengajar (manusia) dengan perantaran kalam,",
   "tajweed": "ٱلَّذِى عَلَّمَ بِ[h:14561[ٱ]لْقَلَمِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/096004.mp3"
  },
  {
   "number": 5,
   "globalNumber": 6111,
   "juz": 30,
   "page": 597,
   "text": "عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ",
   "translation": "Dia mengajar kepada manusia apa yang tidak diketahuinya.",
   "tajweed": "عَلَّمَ [h:14562[ٱ]لْإِ[f:5969[نس]َ[n[ـٰ]نَ مَا لَمْ يَعْلَمْ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/096005.mp3"
  },
  {
   "number": 6,
   "globalNumber": 6112,
   "juz": 30,
   "page": 597,
   "text": "كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ",
   "translation": "Ketahuilah! Sesungguhnya manusia benar-benar melampaui batas,",
   "tajweed": "كَلّ[o[َآ] إِ[g[نّ]َ [h:7137[ٱ]لْإِ[f:5969[نس]َ[n[ـٰ]نَ لَيَ[q:14563[طْ]غَىٰٓ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/096006.mp3"
  },
  {
   "number": 7,
   "globalNumber": 6113,
   "juz": 30,
   "page": 597,
   "text": "أَن رَّءَاهُ ٱسْتَغْنَىٰٓ",
   "translation": "karena dia melihat dirinya serba cukup.",
   "tajweed": "أ[u:14564[َن ر]َّءَاهُ [h:14565[ٱ]سْتَغْنَىٰٓ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/096007.mp3"
  },
  {
   "number": 8,
   "globalNumber": 6114,
   "juz": 30,
   "page": 597,
   "text": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ",
   "translation": "Sesungguhnya hanya kepada Tuhanmulah kembali(mu).",
   "tajweed": "إِ[g[نّ]َ إِلَىٰ رَبِّكَ [h:14566[ٱ][l[ل]رُّ[q:14567[جْ]عَىٰٓ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/096008.mp3"
  },
  {
   "number": 9,
   "globalNumber": 6115,
   "juz": 30,
   "page": 597,
   "text": "أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ",
   "translation": "Bagaimana pendapatmu tentang orang yang melarang,",
   "tajweed": "أَرَءَيْتَ [h:14568[ٱ]لَّذِى يَنْهَىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/096009.mp3"
  },
  {
   "number": 10,
   "globalNumber": 6116,
   "juz": 30,
   "page": 597,
   "text": "عَبْدًا إِذَا صَلَّىٰٓ",
   "translation": "seorang hamba ketika mengerjakan shalat,",
   "tajweed": "عَ[q:3317[بْ]دًا إِذَا صَلَّىٰٓ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/096010.mp3"
  },
  {
   "number": 11,
   "globalNumber": 6117,
   "juz": 30,
   "page": 597,
   "text": "أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ",
   "translation": "bagaimana pendapatmu jika orang yang melarang itu berada di atas kebenaran,",
   "tajweed": "أَرَءَيْتَ إِ[f:2594[ن ك]َانَ عَلَى [h:4019[ٱ]لْهُدَىٰٓ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/096011.mp3"
  },
  {
   "number": 12,
   "globalNumber": 6118,
   "juz": 30,
   "page": 597,
   "text": "أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ",
   "translation": "atau dia menyuruh bertakwa (kepada Allah)?",
   "tajweed": "أَوْ أَمَرَ بِ[h:14569[ٱ][l[ل]تَّ[q:14569[قْ]وَىٰٓ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/096012.mp3"
  },
  {
   "number": 13,
   "globalNumber": 6119,
   "juz": 30,
   "page": 597,
   "text": "أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ",
   "translation": "Bagaimana pendapatmu jika orang yang melarang itu mendustakan dan berpaling?",
   "tajweed": "أَرَءَيْتَ إِ[f:14570[ن ك]َذَّبَ وَتَوَلَّىٰٓ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/096013.mp3"
  },
  {
   "number": 14,
   "globalNumber": 6120,
   "juz": 30,
   "page": 597,
   "text": "أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ",
   "translation": "Tidaklah dia mengetahui bahwa sesungguhnya Allah melihat segala perbuatannya?",
   "tajweed": "أَلَمْ يَعْل[c:14571[َم ب]ِأَ[g[نّ]َ [h:897[ٱ]للَّهَ يَرَىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/096014.mp3"
  },
  {
   "number": 15,
   "globalNumber": 6121,
   "juz": 30,
   "page": 597,
   "text": "كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ",
   "translation": "Ketahuilah, sungguh jika dia tidak berhenti (berbuat demikian) niscaya Kami tarik ubun-ubunnya,",
   "tajweed": "كَلَّا لَئ[u:4195[ِن ل]َّمْ يَ[f:10891[نت]َهِ لَنَسْفَع[i:14572[َۢا ب]ِ[h:14573[ٱ][l[ل][g[نّ]َاصِيَةِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/096015.mp3"
  },
  {
   "number": 16,
   "globalNumber": 6122,
   "juz": 30,
   "page": 597,
   "text": "نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ",
   "translation": "(yaitu) ubun-ubun orang yang mendustakan lagi durhaka.",
   "tajweed": "نَاصِيَ[f:14574[ةٍ ك]َ[n[ـٰ]ذِبَةٍ خَاطِئَةٍ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/096016.mp3"
  },
  {
   "number": 17,
   "globalNumber": 6123,
   "juz": 30,
   "page": 597,
   "text": "فَلْيَدْعُ نَادِيَهُۥ",
   "translation": "Maka biarlah dia memanggil golongannya (untuk menolongnya),",
   "tajweed": "فَلْيَ[q:14575[دْ]عُ نَادِيَهُۥ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/096017.mp3"
  },
  {
   "number": 18,
   "globalNumber": 6124,
   "juz": 30,
   "page": 597,
   "text": "سَنَدْعُ ٱلزَّبَانِيَةَ",
   "translation": "kelak Kami akan memanggil malaikat Zabaniyah,",
   "tajweed": "سَنَ[q:14576[دْ]عُ [h:14577[ٱ][l[ل]زَّبَانِيَةَ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/096018.mp3"
  },
  {
   "number": 19,
   "globalNumber": 6125,
   "juz": 30,
   "page": 597,
   "text": "كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩",
   "translation": "sekali-kali jangan, janganlah kamu patuh kepadanya; dan sujudlah dan dekatkanlah (dirimu kepada Tuhan).",
   "tajweed": "كَلَّا لَا تُطِعْهُ وَ[h:14578[ٱ]سْجُ[q:14578[دْ] وَ[h:14579[ٱ][q:14579[قْ]تَرِ[q[ب] ۩",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/096019.mp3"
  }
 ]
}
