{
 "number": 86,
 "name": "سُورَةُ الطَّارِقِ",
 "englishName": "At-Taariq",
 "englishNameTranslation": "The Morning Star",
 "revelationType": "Meccan",
 "ayahCount": 17,
 "hasBasmalah": true,
 "ayahs": [
  {
   "number": 1,
   "globalNumber": 5932,
   "juz": 30,
   "page": 591,
   "text": "وَٱلسَّمَآءِ وَٱلطَّارِقِ",
   "translation": "Demi langit dan yang datang pada malam hari,",
   "tajweed": "وَ[h:9999[ٱ][l[ل]سَّم[o[َا]ٓءِ وَ[h:14418[ٱ][l[ل]طَّارِ[q[ق]ِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/086001.mp3"
  },
  {
   "number": 2,
   "globalNumber": 5933,
   "juz": 30,
   "page": 591,
   "text": "وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ",
   "translation": "tahukah kamu apakah yang datang pada malam hari itu?",
   "tajweed": "وَم[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا [h:14419[ٱ][l[ل]طَّارِ[q[ق]ُ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/086002.mp3"
  },
  {
   "number": 3,
   "globalNumber": 5934,
   "juz": 30,
   "page": 591,
   "text": "ٱلنَّجْمُ ٱلثَّاقِبُ",
   "translation": "(yaitu) bintang yang cahayanya menembus,",
   "tajweed": "ٱ[l[ل][g[نّ]َ[q:14420[جْ]مُ [h:14421[ٱ][l[ل]ثَّاقِ[q[ب]ُ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/086003.mp3"
  },
  {
   "number": 4,
   "globalNumber": 5935,
   "juz": 30,
   "page": 591,
   "text": "إِن كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ",
   "translation": "tidak ada suatu jiwapun (diri) melainkan ada penjaganya.",
   "tajweed": "إِ[f:8426[ن ك]ُلُّ نَفْ[u:14422[سٍ ل]َّ[g[مّ]َا عَلَيْهَا حَافِظٌ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/086004.mp3"
  },
  {
   "number": 5,
   "globalNumber": 5936,
   "juz": 30,
   "page": 591,
   "text": "فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ",
   "translation": "Maka hendaklah manusia memperhatikan dari apakah dia diciptakan?",
   "tajweed": "فَلْيَ[f:14313[نظ]ُرِ [h:14314[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ مِ[g[مّ]َ خُلِ[q[ق]َ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/086005.mp3"
  },
  {
   "number": 6,
   "globalNumber": 5937,
   "juz": 30,
   "page": 591,
   "text": "خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ",
   "translation": "Dia diciptakan dari air yang dipancarkan,",
   "tajweed": "خُلِقَ م[a:840[ِن م]ّ[o[َا]ٓ[f:14423[ءٍ د]َافِ[q[ق]ٍ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/086006.mp3"
  },
  {
   "number": 7,
   "globalNumber": 5938,
   "juz": 30,
   "page": 591,
   "text": "يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ",
   "translation": "yang keluar dari antara tulang sulbi laki-laki dan tulang dada perempuan.",
   "tajweed": "يَخْرُجُ م[i:4612[ِنۢ ب]َيْنِ [h:14424[ٱ][l[ل]صُّلْبِ وَ[h:14425[ٱ][l[ل]تَّر[o[َا]ٓئِ[q[ب]ِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/086007.mp3"
  },
  {
   "number": 8,
   "globalNumber": 5939,
   "juz": 30,
   "page": 591,
   "text": "إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ",
   "translation": "Sesungguhnya Allah benar-benar kuasa untuk mengembalikannya (hidup sesudah mati).",
   "tajweed": "إِ[g[نّ]َهُ[n[ۥ] عَلَىٰ رَ[q:14426[جْ]عِه[n[ِۦ] لَقَادِرٌ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/086008.mp3"
  },
  {
   "number": 9,
   "globalNumber": 5940,
   "juz": 30,
   "page": 591,
   "text": "يَوْمَ تُبْلَى ٱلسَّرَآئِرُ",
   "translation": "Pada hari dinampakkan segala rahasia,",
   "tajweed": "يَوْمَ تُ[q:14427[بْ]لَى [h:14428[ٱ][l[ل]سَّر[o[َا]ٓئِرُ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/086009.mp3"
  },
  {
   "number": 10,
   "globalNumber": 5941,
   "juz": 30,
   "page": 591,
   "text": "فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ",
   "translation": "maka sekali-kali tidak ada bagi manusia itu suatu kekuatanpun dan tidak (pula) seorang penolong.",
   "tajweed": "فَمَا لَهُ[n[ۥ] مِ[f:5395[ن ق]ُوَّ[a:14429[ةٍ و]َلَا نَاصِرٍ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/086010.mp3"
  },
  {
   "number": 11,
   "globalNumber": 5942,
   "juz": 30,
   "page": 591,
   "text": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ",
   "translation": "Demi langit yang mengandung hujan",
   "tajweed": "وَ[h:9999[ٱ][l[ل]سَّم[o[َا]ٓءِ ذَاتِ [h:14430[ٱ][l[ل]رَّ[q:14431[جْ]عِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/086011.mp3"
  },
  {
   "number": 12,
   "globalNumber": 5943,
   "juz": 30,
   "page": 591,
   "text": "وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ",
   "translation": "dan bumi yang mempunyai tumbuh-tumbuhan,",
   "tajweed": "وَ[h:9999[ٱ]لْأَرْضِ ذَاتِ [h:14432[ٱ][l[ل]صَّ[q:14433[دْ]عِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/086012.mp3"
  },
  {
   "number": 13,
   "globalNumber": 5944,
   "juz": 30,
   "page": 591,
   "text": "إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ",
   "translation": "sesungguhnya Al Quran itu benar-benar firman yang memisahkan antara yang hak dan yang bathil.",
   "tajweed": "إِ[g[نّ]َهُ[n[ۥ] لَقَوْ[f:14434[لٌ ف]َصْلٌ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/086013.mp3"
  },
  {
   "number": 14,
   "globalNumber": 5945,
   "juz": 30,
   "page": 591,
   "text": "وَمَا هُوَ بِٱلْهَزْلِ",
   "translation": "dan sekali-kali bukanlah dia senda gurau.",
   "tajweed": "وَمَا هُوَ بِ[h:14435[ٱ]لْهَزْلِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/086014.mp3"
  },
  {
   "number": 15,
   "globalNumber": 5946,
   "juz": 30,
   "page": 591,
   "text": "إِنَّهُمْ يَكِيدُونَ كَيْدًۭا",
   "translation": "Sesungguhnya orang kafir itu merencanakan tipu daya yang jahat dengan sebenar-benarnya.",
   "tajweed": "إِ[g[نّ]َهُمْ يَكِيدُونَ كَيْدًا",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/086015.mp3"
  },
  {
   "number": 16,
   "globalNumber": 5947,
   "juz": 30,
   "page": 591,
   "text": "وَأَكِيدُ كَيْدًۭا",
   "translation": "Dan Akupun membuat rencana (pula) dengan sebenar-benarnya.",
   "tajweed": "وَأَكِيدُ كَيْدًا",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/086016.mp3"
  },
  {
   "number": 17,
   "globalNumber": 5948,
   "juz": 30,
   "page": 591,
   "text": "فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا",
   "translation": "Karena itu beri tangguhlah orang-orang kafir itu yaitu beri tangguhlah mereka itu barang sebentar.",
   "tajweed": "فَمَهِّلِ [h:14436[ٱ]لْكَ[n[ـٰ]فِرِينَ أَمْهِلْهُمْ رُوَيْدَۢا",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/086017.mp3"
  }
 ]
}
