{
 "number": 80,
 "name": "سُورَةُ عَبَسَ",
 "englishName": "Abasa",
 "englishNameTranslation": "He frowned",
 "revelationType": "Meccan",
 "ayahCount": 42,
 "hasBasmalah": true,
 "ayahs": [
  {
   "number": 1,
   "globalNumber": 5759,
   "juz": 30,
   "page": 585,
   "text": "عَبَسَ وَتَوَلَّىٰٓ",
   "translation": "Dia (Muhammad) bermuka masam dan berpaling,",
   "tajweed": "عَبَسَ وَتَوَلَّىٰٓ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080001.mp3"
  },
  {
   "number": 2,
   "globalNumber": 5760,
   "juz": 30,
   "page": 585,
   "text": "أَن جَآءَهُ ٱلْأَعْمَىٰ",
   "translation": "karena telah datang seorang buta kepadanya.",
   "tajweed": "أَ[f:14298[ن ج][o[َا]ٓءَهُ [h:14299[ٱ]لْأَعْمَىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080002.mp3"
  },
  {
   "number": 3,
   "globalNumber": 5761,
   "juz": 30,
   "page": 585,
   "text": "وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ",
   "translation": "Tahukah kamu barangkali ia ingin membersihkan dirinya (dari dosa),",
   "tajweed": "وَمَا يُ[q:10898[دْ]رِيكَ لَعَلَّهُ[n[ۥ] يَزَّكَّىٰٓ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080003.mp3"
  },
  {
   "number": 4,
   "globalNumber": 5762,
   "juz": 30,
   "page": 585,
   "text": "أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ",
   "translation": "atau dia (ingin) mendapatkan pengajaran, lalu pengajaran itu memberi manfaat kepadanya?",
   "tajweed": "أَوْ يَذَّكَّرُ فَتَ[f:14300[نف]َعَهُ [h:14301[ٱ][l[ل]ذِّكْرَىٰٓ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080004.mp3"
  },
  {
   "number": 5,
   "globalNumber": 5763,
   "juz": 30,
   "page": 585,
   "text": "أَمَّا مَنِ ٱسْتَغْنَىٰ",
   "translation": "Adapun orang yang merasa dirinya serba cukup,",
   "tajweed": "أَ[g[مّ]َا مَنِ [h:14302[ٱ]سْتَغْنَىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080005.mp3"
  },
  {
   "number": 6,
   "globalNumber": 5764,
   "juz": 30,
   "page": 585,
   "text": "فَأَنتَ لَهُۥ تَصَدَّىٰ",
   "translation": "maka kamu melayaninya.",
   "tajweed": "فَأَ[f:14303[نت]َ لَهُ[n[ۥ] تَصَدَّىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080006.mp3"
  },
  {
   "number": 7,
   "globalNumber": 5765,
   "juz": 30,
   "page": 585,
   "text": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ",
   "translation": "Padahal tidak ada (celaan) atasmu kalau dia tidak membersihkan diri (beriman).",
   "tajweed": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080007.mp3"
  },
  {
   "number": 8,
   "globalNumber": 5766,
   "juz": 30,
   "page": 585,
   "text": "وَأَمَّا مَن جَآءَكَ يَسْعَىٰ",
   "translation": "Dan adapun orang yang datang kepadamu dengan bersegera (untuk mendapatkan pengajaran),",
   "tajweed": "وَأَ[g[مّ]َا مَ[f:14304[ن ج][o[َا]ٓءَكَ يَسْعَىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080008.mp3"
  },
  {
   "number": 9,
   "globalNumber": 5767,
   "juz": 30,
   "page": 585,
   "text": "وَهُوَ يَخْشَىٰ",
   "translation": "sedang ia takut kepada (Allah),",
   "tajweed": "وَهُوَ يَخْشَىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080009.mp3"
  },
  {
   "number": 10,
   "globalNumber": 5768,
   "juz": 30,
   "page": 585,
   "text": "فَأَنتَ عَنْهُ تَلَهَّىٰ",
   "translation": "maka kamu mengabaikannya.",
   "tajweed": "فَأَ[f:14303[نت]َ عَنْهُ تَلَهَّىٰ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080010.mp3"
  },
  {
   "number": 11,
   "globalNumber": 5769,
   "juz": 30,
   "page": 585,
   "text": "كَلَّآ إِنَّهَا تَذْكِرَةٌۭ",
   "translation": "Sekali-kali jangan (demikian)! Sesungguhnya ajaran-ajaran Tuhan itu adalah suatu peringatan,",
   "tajweed": "كَلّ[o[َآ] إِ[g[نّ]َهَا تَذْكِرَةٌ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080011.mp3"
  },
  {
   "number": 12,
   "globalNumber": 5770,
   "juz": 30,
   "page": 585,
   "text": "فَمَن شَآءَ ذَكَرَهُۥ",
   "translation": "maka barangsiapa yang menghendaki, tentulah ia memperhatikannya,",
   "tajweed": "فَمَ[f:8041[ن ش][o[َا]ٓءَ ذَكَرَهُۥ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080012.mp3"
  },
  {
   "number": 13,
   "globalNumber": 5771,
   "juz": 30,
   "page": 585,
   "text": "فِى صُحُفٍۢ مُّكَرَّمَةٍۢ",
   "translation": "di dalam kitab-kitab yang dimuliakan,",
   "tajweed": "فِى صُحُ[a:14305[فٍ م]ُّكَرَّمَةٍ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080013.mp3"
  },
  {
   "number": 14,
   "globalNumber": 5772,
   "juz": 30,
   "page": 585,
   "text": "مَّرْفُوعَةٍۢ مُّطَهَّرَةٍۭ",
   "translation": "yang ditinggikan lagi disucikan,",
   "tajweed": "مَّرْفُوعَ[a:14306[ةٍ م]ُّطَهَّرَةِۭ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080014.mp3"
  },
  {
   "number": 15,
   "globalNumber": 5773,
   "juz": 30,
   "page": 585,
   "text": "بِأَيْدِى سَفَرَةٍۢ",
   "translation": "di tangan para penulis (malaikat),",
   "tajweed": "بِأَيْدِى سَفَرَةٍ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080015.mp3"
  },
  {
   "number": 16,
   "globalNumber": 5774,
   "juz": 30,
   "page": 585,
   "text": "كِرَامٍۭ بَرَرَةٍۢ",
   "translation": "yang mulia lagi berbakti.",
   "tajweed": "كِرَا[i:14307[مِۭ ب]َرَرَةٍ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080016.mp3"
  },
  {
   "number": 17,
   "globalNumber": 5775,
   "juz": 30,
   "page": 585,
   "text": "قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ",
   "translation": "Binasalah manusia; alangkah amat sangat kekafirannya?",
   "tajweed": "قُتِلَ [h:14308[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ م[o[َآ] أَكْفَرَهُۥ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080017.mp3"
  },
  {
   "number": 18,
   "globalNumber": 5776,
   "juz": 30,
   "page": 585,
   "text": "مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ",
   "translation": "Dari apakah Allah menciptakannya?",
   "tajweed": "مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080018.mp3"
  },
  {
   "number": 19,
   "globalNumber": 5777,
   "juz": 30,
   "page": 585,
   "text": "مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ",
   "translation": "Dari setetes mani, Allah menciptakannya lalu menentukannya.",
   "tajweed": "م[a:7325[ِن ن]ُّ[q:7326[طْ]فَةٍ خَلَقَهُ[n[ۥ] فَقَدَّرَهُۥ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080019.mp3"
  },
  {
   "number": 20,
   "globalNumber": 5778,
   "juz": 30,
   "page": 585,
   "text": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ",
   "translation": "Kemudian Dia memudahkan jalannya.",
   "tajweed": "ثُ[g[مّ]َ [h:14309[ٱ][l[ل]سَّبِيلَ يَسَّرَهُۥ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080020.mp3"
  },
  {
   "number": 21,
   "globalNumber": 5779,
   "juz": 30,
   "page": 585,
   "text": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ",
   "translation": "kemudian Dia mematikannya dan memasukkannya ke dalam kubur,",
   "tajweed": "ثُ[g[مّ]َ أَمَاتَهُ[n[ۥ] فَأَ[q:14310[قْ]بَرَهُۥ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080021.mp3"
  },
  {
   "number": 22,
   "globalNumber": 5780,
   "juz": 30,
   "page": 585,
   "text": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ",
   "translation": "kemudian bila Dia menghendaki, Dia membangkitkannya kembali.",
   "tajweed": "ثُ[g[مّ]َ إِذَا ش[o[َا]ٓءَ أَ[f:14311[نش]َرَهُۥ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080022.mp3"
  },
  {
   "number": 23,
   "globalNumber": 5781,
   "juz": 30,
   "page": 585,
   "text": "كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ",
   "translation": "Sekali-kali jangan; manusia itu belum melaksanakan apa yang diperintahkan Allah kepadanya,",
   "tajweed": "كَلَّا لَ[g[مّ]َا يَ[q:14312[قْ]ضِ م[o[َآ] أَمَرَهُۥ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080023.mp3"
  },
  {
   "number": 24,
   "globalNumber": 5782,
   "juz": 30,
   "page": 585,
   "text": "فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ",
   "translation": "maka hendaklah manusia itu memperhatikan makanannya.",
   "tajweed": "فَلْيَ[f:14313[نظ]ُرِ [h:14314[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ إِلَىٰ طَعَامِهِۦٓ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080024.mp3"
  },
  {
   "number": 25,
   "globalNumber": 5783,
   "juz": 30,
   "page": 585,
   "text": "أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّۭا",
   "translation": "Sesungguhnya Kami benar-benar telah mencurahkan air (dari langit),",
   "tajweed": "أَ[g[نّ]َا صَبَ[q:14315[بْ]نَا [h:14316[ٱ]لْم[o[َا]ٓءَ صَبًّا",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080025.mp3"
  },
  {
   "number": 26,
   "globalNumber": 5784,
   "juz": 30,
   "page": 585,
   "text": "ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّۭا",
   "translation": "kemudian Kami belah bumi dengan sebaik-baiknya,",
   "tajweed": "ثُ[g[مّ]َ شَقَ[q:14317[قْ]نَا [h:14318[ٱ]لْأَرْضَ شَقًّا",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080026.mp3"
  },
  {
   "number": 27,
   "globalNumber": 5785,
   "juz": 30,
   "page": 585,
   "text": "فَأَنۢبَتْنَا فِيهَا حَبًّۭا",
   "translation": "lalu Kami tumbuhkan biji-bijian di bumi itu,",
   "tajweed": "فَأَ[i:9998[نۢب]َتْنَا فِيهَا حَبًّا",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080027.mp3"
  },
  {
   "number": 28,
   "globalNumber": 5786,
   "juz": 30,
   "page": 585,
   "text": "وَعِنَبًۭا وَقَضْبًۭا",
   "translation": "anggur dan sayur-sayuran,",
   "tajweed": "وَعِنَ[a:14319[بًا و]َقَضْبًا",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080028.mp3"
  },
  {
   "number": 29,
   "globalNumber": 5787,
   "juz": 30,
   "page": 585,
   "text": "وَزَيْتُونًۭا وَنَخْلًۭا",
   "translation": "zaitun dan kurma,",
   "tajweed": "وَزَيْتُو[a:14320[نًا و]َنَخْلاً",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080029.mp3"
  },
  {
   "number": 30,
   "globalNumber": 5788,
   "juz": 30,
   "page": 585,
   "text": "وَحَدَآئِقَ غُلْبًۭا",
   "translation": "kebun-kebun (yang) lebat,",
   "tajweed": "وَحَد[o[َا]ٓئِقَ غُلْبًا",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080030.mp3"
  },
  {
   "number": 31,
   "globalNumber": 5789,
   "juz": 30,
   "page": 585,
   "text": "وَفَٰكِهَةًۭ وَأَبًّۭا",
   "translation": "dan buah-buahan serta rumput-rumputan,",
   "tajweed": "وَفَ[n[ـٰ]كِهَ[a:14321[ةً و]َأَبًّا",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080031.mp3"
  },
  {
   "number": 32,
   "globalNumber": 5790,
   "juz": 30,
   "page": 585,
   "text": "مَّتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ",
   "translation": "untuk kesenanganmu dan untuk binatang-binatang ternakmu.",
   "tajweed": "مَّتَ[n[ـٰ][u:3808[عًا ل]َّكُمْ وَلِأَنْعَ[n[ـٰ]مِكُمْ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080032.mp3"
  },
  {
   "number": 33,
   "globalNumber": 5791,
   "juz": 30,
   "page": 585,
   "text": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ",
   "translation": "Dan apabila datang suara yang memekakkan (tiupan sangkakala yang kedua),",
   "tajweed": "فَإِذَا ج[o[َا]ٓءَتِ [h:14322[ٱ][l[ل]صّ[m[َا]ٓخَّةُ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080033.mp3"
  },
  {
   "number": 34,
   "globalNumber": 5792,
   "juz": 30,
   "page": 585,
   "text": "يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ",
   "translation": "pada hari ketika manusia lari dari saudaranya,",
   "tajweed": "يَوْمَ يَفِرُّ [h:14323[ٱ]لْمَرْءُ مِنْ أَخ[p[ِي]هِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080034.mp3"
  },
  {
   "number": 35,
   "globalNumber": 5793,
   "juz": 30,
   "page": 585,
   "text": "وَأُمِّهِۦ وَأَبِيهِ",
   "translation": "dari ibu dan bapaknya,",
   "tajweed": "وَأُ[g[مّ]ِه[n[ِۦ] وَأَب[p[ِي]هِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080035.mp3"
  },
  {
   "number": 36,
   "globalNumber": 5794,
   "juz": 30,
   "page": 585,
   "text": "وَصَٰحِبَتِهِۦ وَبَنِيهِ",
   "translation": "dari istri dan anak-anaknya.",
   "tajweed": "وَصَ[n[ـٰ]حِبَتِه[n[ِۦ] وَبَن[p[ِي]هِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080036.mp3"
  },
  {
   "number": 37,
   "globalNumber": 5795,
   "juz": 30,
   "page": 585,
   "text": "لِكُلِّ ٱمْرِئٍۢ مِّنْهُمْ يَوْمَئِذٍۢ شَأْنٌۭ يُغْنِيهِ",
   "translation": "Setiap orang dari mereka pada hari itu mempunyai urusan yang cukup menyibukkannya.",
   "tajweed": "لِكُلِّ [h:9345[ٱ]مْرِى[a:9346[ٍٕ م]ِّنْهُمْ يَوْمَئِ[f:14324[ذٍ ش]َأْ[a:14325[نٌ ي]ُغْن[p[ِي]هِ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080037.mp3"
  },
  {
   "number": 38,
   "globalNumber": 5796,
   "juz": 30,
   "page": 585,
   "text": "وُجُوهٌۭ يَوْمَئِذٍۢ مُّسْفِرَةٌۭ",
   "translation": "Banyak muka pada hari itu berseri-seri,",
   "tajweed": "وُجُو[a:14135[هٌ ي]َوْمَئِ[a:14326[ذٍ م]ُّسْفِرَةٌ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080038.mp3"
  },
  {
   "number": 39,
   "globalNumber": 5797,
   "juz": 30,
   "page": 585,
   "text": "ضَاحِكَةٌۭ مُّسْتَبْشِرَةٌۭ",
   "translation": "tertawa dan bergembira ria,",
   "tajweed": "ضَاحِكَ[a:14327[ةٌ م]ُّسْتَ[q:14328[بْ]شِرَةٌ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080039.mp3"
  },
  {
   "number": 40,
   "globalNumber": 5798,
   "juz": 30,
   "page": 585,
   "text": "وَوُجُوهٌۭ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌۭ",
   "translation": "dan banyak (pula) muka pada hari itu tertutup debu,",
   "tajweed": "وَوُجُو[a:14137[هٌ ي]َوْمَئِذٍ عَلَيْهَا غَبَرَةٌ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/080040.mp3"
  },
  {
   "number": 41,
   "globalNumber": 5799,
   "juz": 30,
   "page": 585,
