 "ayahs": [
  {
   "number": 1,
   "globalNumber": 6044,
   "juz": 30,
   "page": 595,
   "text": "وَٱلشَّمْسِ وَضُحَىٰهَا",
   "translation": "Demi matahari dan cahayanya di pagi hari,",
   "tajweed": "وَ[h:9999[ٱ][l[ل]شَّمْسِ وَضُحَ[n[ـٰ]هَا",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/091001.mp3"
  },
  {
   "number": 2,
   "globalNumber": 6045,
   "juz": 30,
   "page": 595,
   "text": "وَٱلْقَمَرِ إِذَا تَلَىٰهَا",
   "translation": "dan bulan apabila mengiringinya,",
   "tajweed": "وَ[h:9999[ٱ]لْقَمَرِ إِذَا تَلَ[n[ـٰ]هَا",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/091002.mp3"
  },
  {
   "number": 3,
   "globalNumber": 6046,
   "juz": 30,
   "page": 595,
   "text": "وَٱلنَّهَارِ إِذَا جَلَّىٰهَا",
   "translation": "dan siang apabila menampakkannya,",
   "tajweed": "وَ[h:9999[ٱ][l[ل][g[نّ]َهَارِ إِذَا جَلَّ[n[ـٰ]هَا",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/091003.mp3"
  },
  {
   "number": 4,
   "globalNumber": 6047,
   "juz": 30,
   "page": 595,
   "text": "وَٱلَّيْلِ إِذَا يَغْشَىٰهَا",
   "translation": "dan malam apabila menutupinya,",
   "tajweed": "وَ[h:9999[ٱ]لَّيْلِ إِذَا يَغْشَ[n[ـٰ]هَا",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/091004.mp3"
  },
  {
   "number": 5,
   "globalNumber": 6048,
   "juz": 30,
   "page": 595,
   "text": "وَٱلسَّمَآءِ وَمَا بَنَىٰهَا",
   "translation": "dan langit serta pembinaannya,",
   "tajweed": "وَ[h:9999[ٱ][l[ل]سَّم[o[َا]ٓءِ وَمَا بَنَ[n[ـٰ]هَا",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/091005.mp3"
  },
  {
   "number": 6,
   "globalNumber": 6049,
   "juz": 30,
   "page": 595,
   "text": "وَٱلْأَرْضِ وَمَا طَحَىٰهَا",
   "translation": "dan bumi serta penghamparannya,",
   "tajweed": "وَ[h:9999[ٱ]لْأَرْضِ وَمَا طَحَ[n[ـٰ]هَا",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/091006.mp3"
  },
  {
   "number": 7,
   "globalNumber": 6050,
   "juz": 30,
   "page": 595,
   "text": "وَنَفْسٍۢ وَمَا سَوَّىٰهَا",
   "translation": "dan jiwa serta penyempurnaannya (ciptaannya),",
   "tajweed": "وَنَفْ[a:14521[سٍ و]َمَا سَوَّ[n[ٮٰ]هَا",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/091007.mp3"
  },
  {
   "number": 8,
   "globalNumber": 6051,
   "juz": 30,
   "page": 595,
   "text": "فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا",
   "translation": "maka Allah mengilhamkan kepada jiwa itu (jalan) kefasikan dan ketakwaannya.",
   "tajweed": "فَأَلْهَمَهَا فُجُورَهَا وَتَ[q:14522[قْ]وَ[n[ٮٰ]هَا",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/091008.mp3"
  },
  {
   "number": 9,
   "globalNumber": 6052,
   "juz": 30,
   "page": 595,
   "text": "قَدْ أَفْلَحَ مَن زَكَّىٰهَا",
   "translation": "sesungguhnya beruntunglah orang yang mensucikan jiwa itu,",
   "tajweed": "قَ[q:298[دْ] أَفْلَحَ مَ[f:14523[ن ز]َكَّ[n[ـٰ]هَا",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/091009.mp3"
  },
  {
   "number": 10,
   "globalNumber": 6053,
   "juz": 30,
   "page": 595,
   "text": "وَقَدْ خَابَ مَن دَسَّىٰهَا",
   "translation": "dan sesungguhnya merugilah orang yang mengotorinya.",
   "tajweed": "وَقَ[q:387[دْ] خَابَ مَ[f:14524[ن د]َسَّ[n[ـٰ]هَا",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/091010.mp3"
  },
  {
   "number": 11,
   "globalNumber": 6054,
   "juz": 30,
   "page": 595,
   "text": "كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ",
   "translation": "(Kaum) Tsamud telah mendustakan (rasulnya) karena mereka melampaui batas,",
   "tajweed": "كَذَّبَتْ ثَمُودُ بِطَغْوَ[n[ٮٰ]هَآ",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/091011.mp3"
  },
  {
   "number": 12,
   "globalNumber": 6055,
   "juz": 30,
   "page": 595,
   "text": "إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا",
   "translation": "ketika bangkit orang yang paling celaka di antara mereka,",
   "tajweed": "إِذِ [h:14525[ٱ][i:14526[نۢب]َعَثَ أَشْقَ[n[ـٰ]هَا",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/091012.mp3"
  },
  {
   "number": 13,
   "globalNumber": 6056,
   "juz": 30,
   "page": 595,
   "text": "فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَٰهَا",
   "translation": "lalu Rasul Allah (Saleh) berkata kepada mereka: (\"Biarkanlah) unta betina Allah dan minumannya\".",
   "tajweed": "فَقَالَ لَهُمْ رَسُولُ [h:3306[ٱ]للَّهِ نَاقَةَ [h:14527[ٱ]للَّهِ وَسُ[q:14528[قْ]يَ[n[ـٰ]هَا",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/091013.mp3"
  },
  {
   "number": 14,
   "globalNumber": 6057,
   "juz": 30,
   "page": 595,
   "text": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا",
   "translation": "Lalu mereka mendustakannya dan menyembelih unta itu, maka Tuhan mereka membinasakan mereka disebabkan dosa mereka, lalu Allah menyama-ratakan mereka (dengan tanah),",
   "tajweed": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّه[c:14529[ُم ب]ِذَ[i:13779[نۢب]ِهِمْ فَسَوَّ[n[ٮٰ]هَا",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/091014.mp3"
  },
  {
   "number": 15,
   "globalNumber": 6058,
   "juz": 30,
   "page": 595,
   "text": "وَلَا يَخَافُ عُقْبَٰهَا",
   "translation": "dan Allah tidak takut terhadap akibat tindakan-Nya itu.",
   "tajweed": "وَلَا يَخَافُ عُ[q:14530[قْ]بَ[n[ـٰ]هَا",
   "audio": "https://everyayah.com/data/Alafasy_128kbps/091015.mp3"
  }
 ]
}
